---
import { getEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HeaderMain from "../../../components/headers/HeaderMainAlternative.astro";
import TextIcons from "../../../components/sections/TextIcons.astro";
import SimulatorOfferCTA from "../../../components/simulators/SimulatorOfferCTA.astro";
import SimulatorImageSection from "../../../components/offers/SimulatorImageSection.astro";
import CTAAirlineTrack from "../../../components/ctas/CTAAirlineTrack.astro";
import ContactFormStrip from "../../../components/forms/ContactFormStrip.astro";

const entry = await getEntry("simulator", "simulator-redbird-fmx-full-motion-aatd");

if (!entry) {
  throw new Error("Simulator entry not found in src/content/simulator/");
}

const { data } = entry;
---

<BaseLayout
  siteTitle={data.siteTitle || "Flight Simulator Training | Pilot Instructional Center"}
  siteDescription={data.siteDescription || "Redbird FMX flight simulator training."}
  siteKeywords={data.siteKeywords || "flight simulator, Kansas City"}
>
  <HeaderMain content={data.header} />
  <TextIcons content={data.overview} />
  <SimulatorOfferCTA content={data.offerCta} />
  <SimulatorImageSection content={data.imageSection} />
  <CTAAirlineTrack content={data.airlineTrackCTA} />
  <ContactFormStrip />
</BaseLayout>