---
import { getCollection } from "astro:content";
import CTARight from "../../../components/ctas/CTARight.astro";
import Enroll from "../../../components/forms/Enroll.astro";
import HeaderMain from "../../../components/headers/HeaderMainAlternative.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LeadershipMembers from "../../../components/team/LeadershipMembers.astro";

import "aos/dist/aos.css";

export async function getStaticPaths() {
  const teamEntries = await getCollection("team");
  return teamEntries.map((entry) => {
    const slug = entry.id.replace(/\.[^/.]+$/, "");
    return {
      params: { slug },
      props: { member: entry.data },
    };
  });
}

const { member } = Astro.props;

const data = {
  siteTitle: `${member.name} - ${member.role} | Pilot Instructional Center`,
  siteDescription:
    member.bio?.[0] ||
    `Meet ${member.name}, ${member.role} at Pilot Instructional Center.`,
  siteKeywords: `${member.name}, ${member.role}, flight instructor Kansas City, PIC team`,

  header: {
    upperHeader: "Meet the Team",
    title: `Get to know more about ${member.name}`,
    description: `Get to know everything about our instructors and leadership team at Pilot Instructional Center.`,
    buttons: [
      { text: "Start Training", href: "#enroll", style: "btn-secondary" },
      {
        text: "Back to Team",
        href: "/about/our-team/",
        style: "btn-transparent",
      },
    ],
    image: {
      src: "/src/assets/rrm-visit/pilot-instructional-center_new-century-KS_cfis-preparing-plane-cessna-airport-near-Kansas-city-MO-cropped.png",
      alt: member.name,
    },
  },

  cta: {
    title: "Train With Instructors Who Care About Your Success",
    description:
      "Whether you're pursuing a Private Pilot Certificate or advanced ratings, our instructors provide safe, structured, and personalized training.",
    button: { text: "Book a Discovery Session", href: "/discovery-session" },
    image: {
      src: "/src/assets/cta-flight-solid-ground-aviation.webp",
      alt: "View of the sky from an airplane window",
    },
  },
};

// Map member collection data structure to match the component's expected format
const componentContent = {
  upperHeading: "Team Member Profile",
  title: member.name,
  description: member.role,
  descriptions: member.bio,
  team: [
    {
      name: member.name,
      role: member.role,
      roles: member.role,
      description: member.bio?.[0] || "",
      image: member.image,
    },
  ],
};
---

<BaseLayout
  siteTitle={data.siteTitle}
  siteDescription={data.siteDescription}
  siteKeywords={data.siteKeywords}
>
  <HeaderMain
    content={data.header}
    mainSize={false}
    showButton={false}
    images={[data.header.image]}
  />
  <LeadershipMembers content={componentContent} />
  <CTARight />
  <Enroll />
</BaseLayout>
