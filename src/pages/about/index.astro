<BaseLayout
  siteTitle={data.siteTitle}
  siteDescription={data.siteDescription}
  siteKeywords={data.siteKeywords}
>
  <HeaderMain
    content={data.header}
    mainSize={false}
    showButton={false}
    images={[data.header.image]}
    button={{ href: "#contact", text: "Start Your Flying journey" }}
  />

  <section class="bg-primary-300 relative overflow-hidden">
    <ContentMiddle content={data.aboutUs.intro} />
    <GoogleReviews />
    <ContentLeft content={data.aboutUs.history} />
    <ContentRight content={data.aboutUs.mission} />
    <CardsContainter />
    <ContentLeft content={data.aboutUs.cta} />
  </section>
  <TextIcons content={data.whyUs} />
  <ContactFormStrip />
  <!-- <CTARight content={data.cta} /> -->
  <AreasServed />
  <Enroll />
  <MapLocation />
</BaseLayout>
