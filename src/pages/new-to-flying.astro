import { SITE_DESCRIPTION, SITE_TITLE } from "../data/consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramsComponent from "../components/sections/ProgramsComponent.astro";

import "aos/dist/aos.css";
import ImageComp from "../components/utils/ImageComp.astro";
import { link } from "fs";
import SimulatorImageSection from "../components/offers/SimulatorImageSection.astro";

