---

<BaseLayout
  siteTitle={data.siteTitle}
  siteDescription={data.siteDescription}
  siteKeywords={data.siteKeywords}
>
  <HeaderMain
    content={data.header}
    mainSize={false}
    images={[data.header.image]}
  />
  <!-- Why Become a Pilot -->
  <section>
    <div class="bg-stone-100 bg-logo">
      <div class="flex-1 text-primary-600 pt-12">
        <div
          class="flex flex-col px-8 py-12 sm:px-12 lg:py-20 text-center items-center"
          data-aos="zoom-in"
          data-aos-delay="300"
          data-aos-duration="1500"
        >
          <span class="">
            {data.newToFlying.whyBecomePilot.upperHeader}
          </span>
          <h2
            class="text-4xl font-semibold tracking-tight text-pretty sm:text-5xl"
          >
            {data.newToFlying.whyBecomePilot.title}
          </h2>
          <p
            class="mt-6 text-lg text-pretty font-extralight max-w-2xl"
            data-aos="fade-left"
          >
            {data.newToFlying.whyBecomePilot.description}
          </p>

          <ul
            class="flex flex-col lg:flex-row justify-center items-baseline lg:justify-between gap-6 py-2 mt-6 max-w-3xl border-y border-primary-800"
            data-aos="zoom-in"
            data-aos-delay="300"
            data-aos-duration="1500"
          >
            {
              data.newToFlying.whyBecomePilot.bullets.map((bullet: any) => (
                <div class="flex flex-col items-center">
                  <h3 class="font-semibold text-lg mb-2 uppercase w-44 text-center">
                    {bullet.title}
                  </h3>
                  <p class="text-gray-500 max-w-sm">{bullet.description}</p>
                </div>
              ))
            }
          </ul>
          <ImageComp
            src={data.newToFlying.whyBecomePilot.image.src}
            alt={data.newToFlying.whyBecomePilot.image.alt}
            classes="rounded-xl object-cover max-w-lg mt-10 shadow-lg shadow-black/30"
          />
          {
            (
              <div class="grid gap-6 mt-6 lg:grid-cols-2 text-justify py-2 border-y border-primary-800  ">
                {data.newToFlying.whyBecomePilot.descriptions.map(
                  (description: string) => (
                    <p
                      class="mt-4 text-pretty text-lg font-light max-w-xs"
                      data-aos="fade-left"
                    >
                      {description}
                    </p>
                  ),
                )}
              </div>
            )
          }
          <!-- <div class="mt-10 flex">
						<a href={content.button.href} class="btn-accent btn-middle ">
							{content.button.text}
						</a>
					</div> -->
        </div>
      </div>
    </div>
  </section>
  <!-- RoadMap -->
  <section class="relative py-12 bg-stone-100 text-primary-600">
    <div
      class="bg-primary-300 text-white rounded-l-full text-2xl px-4 py-2 pr-[20%] lg:pr-[30%] absolute top-6 right-0 sm:right-0 sm:top-16"
      data-aos="fade-left"
    >
      {data.newToFlying.roadMap.upperHeading}
    </div>
    <div
      class="lg:absolute inset-0 left-0 top-12 z-10 md:w-3/4 lg:w-1/3 xl:1/3 max-h-3/4 mt-12 flex justify-end"
      data-aos="fade-right"
    >
      <ImageComp
        src={data.newToFlying.roadMap.image.src}
        alt={data.newToFlying.roadMap.image.alt}
        classes="object-cover h-full rounded-tr-full rounded-br-full w-full"
      />
    </div>
    <div class="mx-auto flex max-w-4xl flex-col overflow-hidden md:flex-row">
      <div
        class="flex flex-col px-6 py-10 sm:px-10 lg:py-16 text-right items-end text-primary-600 w-full pb-20"
        data-aos="zoom-in"
        data-aos-delay="300"
      >
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-pretty my-6 max-w-3xl"
        >
          {data.newToFlying.roadMap.title}
        </h2>

        {
          !data.newToFlying.roadMap.descriptions && (
            <p class="mt-4 sm:mt-6 text-base sm:text-lg lg:text-xl text-pretty lg:w-2/3">
              {data.newToFlying.roadMap.description}
            </p>
          )
        }
        <div class="max-w-xl pl-12 flex flex-col justify-end items-end">
          {
            (
              <p>
                {data.newToFlying.roadMap.descriptions &&
                  data.newToFlying.roadMap.descriptions.map(
                    (description: any) => `${description} `,
                  )}
              </p>
            )
          }
        </div>

        {
          (
            <div class="">
              {data.newToFlying.roadMap.bullets.map((step: any) => (
                <div
                  class="mt-10 flex flex-col items-end max-w-sm"
                  data-aos="fade-up"
                >
                  <a href={step.link.href} class="btn-accent btn-right ">
                    {step.title}
                  </a>
                  {/* <h3 class="font-semibold text-2xl mb-2 uppercase">
									{step.title}
								</h3> */}
                  <p class="text-gray-500 max-w-2xl text-xl mt-2 py-2 ">
                    {step.description}
                  </p>
                </div>
              ))}
            </div>
          )
        }
        <!-- <a
			href={content.button.href}
			class="btn-accent btn-middle mt-6  bottom-6 right-6 sm:right-0 sm:bottom-8"
			>
			{content.button.text}
			</a> -->
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section class="relative py-12 bg-stone-100 text-primary-600 overflow-hidden">
    <!-- Top floating button -->
    <div
      class="bg-primary-300 text-white rounded-r-full text-2xl px-4 py-2 pl-[20%] lg:pl-[30%] absolute top-6 left-0 sm:left-0 sm:top-16"
      data-aos="fade-right"
    >
      {data.newToFlying.whyPIC.upperHeading}
    </div>

    <!-- Image container on the right -->
    <div
      class="lg:absolute inset-y-0 right-0 top-12 z-10 md:w-3/4 lg:w-1/3 xl:w-1/3 mt-12 max-h-3/4 flex justify-end"
      data-aos="fade-left"
      data-duration="2000"
      data-aos-delay="300"
    >
      <ImageComp
        src={data.newToFlying.whyPIC.image.src}
        alt={data.newToFlying.whyPIC.image.alt}
        classes="object-cover h-full rounded-tl-full rounded-bl-full w-full"
      />
    </div>

    <!-- Text content -->
    <div
      class="mx-auto flex max-w-4xl flex-col overflow-hidden md:flex-row justify-end"
    >
      <div
        class="flex flex-col px-6 py-10 sm:px-10 lg:py-16 text-left items-start w-full pb-20"
        data-aos="zoom-in"
        data-aos-delay="300"
      >
        <h2
          class="text-3xl sm:text-4xl lg:text-6xl font-semibold tracking-tight text-pretty my-6 max-w-2xl"
        >
          {data.newToFlying.whyPIC.title}
        </h2>

        {
          !data.newToFlying.whyPIC.descriptions && (
            <p class="mt-4 sm:mt-6 text-base sm:text-lg lg:text-xl text-pretty  lg:w-2/3">
              {data.newToFlying.whyPIC.description}
            </p>
          )
        }

        <div class="max-w-xl pr-12 flex flex-col justify-end items-start">
          {
            data.newToFlying.whyPIC.descriptions &&
              data.newToFlying.whyPIC.descriptions.map((description: any) => (
                <p class="text-sm lg:text-lg ">{description}</p>
              ))
          }
        </div>

        <!-- <a
			href={content.button.href}
			class="btn-accent btn-middle mt-6 bottom-6 left-6 sm:left-0 sm:bottom-8"
		>
			{content.button.text}
		</a> -->
      </div>
    </div>
  </section>

  <!-- First Steps -->
  <!-- RoadMap -->
  <section class="relative py-12 bg-stone-100 text-primary-600">
    <div
      class="bg-primary-300 text-white rounded-l-full text-2xl px-4 py-2 pr-[20%] lg:pr-[30%] absolute top-6 right-0 sm:right-0 sm:top-16"
      data-aos="fade-left"
    >
      {data.newToFlying.firstSteps.upperHeading}
    </div>
    <div
      class="lg:absolute inset-0 left-0 top-12 z-10 md:w-3/4 lg:w-1/3 xl:1/3 max-h-3/4 mt-12 flex justify-end"
      data-aos="fade-right"
    >
      <ImageComp
        src={data.newToFlying.firstSteps.image.src}
        alt={data.newToFlying.firstSteps.image.alt}
        classes="object-cover h-full rounded-tr-full rounded-br-full w-full"
      />
    </div>
    <div class="mx-auto flex max-w-4xl flex-col overflow-hidden md:flex-row">
      <div
        class="flex flex-col px-6 py-10 sm:px-10 lg:py-16 text-right items-end text-primary-600 w-full pb-20"
        data-aos="zoom-in"
        data-aos-delay="300"
      >
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-pretty my-6 max-w-3xl"
        >
          {data.newToFlying.firstSteps.title}
        </h2>

        {
          !data.newToFlying.firstSteps.descriptions && (
            <p class="mt-4 sm:mt-6 text-base sm:text-lg lg:text-xl text-pretty lg:w-2/3">
              {data.newToFlying.firstSteps.description}
            </p>
          )
        }
        <div class="max-w-xl pl-12 flex flex-col justify-end items-end">
          {
            (
              <p>
                {data.newToFlying.firstSteps.descriptions &&
                  data.newToFlying.firstSteps.descriptions.map(
                    (description: any) => `${description} `,
                  )}
              </p>
            )
          }
        </div>

        {
          (
            <div class="">
              {data.newToFlying.firstSteps.bullets.map((step: any) => (
                <div
                  class="mt-10 flex flex-col items-end max-w-sm"
                  data-aos="fade-up"
                >
                  <a href={step.link.href} class="btn-accent btn-right ">
                    {step.title}
                  </a>
                  {/* <h3 class="font-semibold text-2xl mb-2 uppercase">
									{step.title}
								</h3> */}
                  <p class="text-gray-500 max-w-2xl text-xl mt-2 py-2 ">
                    {step.description}
                  </p>
                </div>
              ))}
            </div>
          )
        }
        <!-- <a
			href={content.button.href}
			class="btn-accent btn-middle mt-6  bottom-6 right-6 sm:right-0 sm:bottom-8"
			>
			{content.button.text}
			</a> -->
      </div>
    </div>
  </section>
  <!-- <Why /> -->
  <Enroll />
  <FAQ />
  <SimulatorImageSection />
</BaseLayout>
