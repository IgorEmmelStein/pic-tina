    content={data.header}
    mainSize={false}
    showButton={false}
    images={[data.header.image]}
    button={data.header.button}
  />
  <OffersStripCTA />
  <WhatIs content={whatIsDiscovery} />
  <Advantages content={picAdvantage} />
  <Filter content={filterDataX} />
  <Steps content={flightSteps} />
  <Difference content={picDifference} />
  <NextSteps content={nextStepsData} />
  <DiscoveryFlightForm />
  <FinalCTA content={finalCtaData} />
  <MapLocation />
  <FAQ />
</BaseLayout>
