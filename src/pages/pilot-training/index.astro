---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import HeaderMain from "../../components/headers/HeaderMainAlternative.astro";
import CTARight from "../../components/ctas/CTARight.astro";
import MapLocation from "../../components/external/MapLocation.astro";
import AreasServed from "../../components/location/AreasServed.astro";
import Enroll from "../../components/forms/Enroll.astro";

const allLocations = await getCollection("pilot-training");
const sortedLocations = allLocations.sort((a, b) =>
  a.data.city.localeCompare(b.data.city),
);

const homeBase = allLocations.find((loc) =>
  loc.data.keyPlace2.includes("New Century"),
);
const otherLocations = sortedLocations.filter((loc) => loc.id !== homeBase?.id);

const data = {
  siteTitle: "Flight Training PIC Areas Served | Serving the Kansas City Metro",
  siteDescription:
    "Discover where Pilot Instructional Center provides elite flight training. From Kansas to Missouri, we're building the next generation of aviators.",
  header: {
    upperHeader: "Our Service Areas",
    title: "Flight Training Across the Kansas City Metro",
    description:
      "Expert instruction meets convenient local access. Choose your city to begin your journey.",
    image: {
      src: "/src/assets/stock/stock_Plane-ground-sunset_roland-denes-MsZEJYU8alE-unsplash.jpg",
      alt: "Pilot training",
    },
  },
};
---

<BaseLayout
  siteTitle={data.siteTitle}
  siteDescription={data.siteDescription}
  siteKeywords="flight training locations"
>
  <HeaderMain content={data.header} />

  <section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8">
    {
      homeBase && (
        <div class="mb-20 overflow-hidden rounded-[2rem] bg-[#423731] text-white shadow-xl">
          <div class="grid md:grid-cols-2">
            <div class="p-10 lg:p-16 flex flex-col justify-center">
              <span class="text-[#dcc1a6] font-semibold uppercase tracking-widest text-sm">
                Our Primary Hub
              </span>
              <h2 class="mt-3 text-4xl font-bold">
                {homeBase.data.city}, {homeBase.data.stateShort}
              </h2>
              <p class="mt-5 text-[#dcc1a6]/80 text-lg leading-relaxed">
                {homeBase.data.header.description}
              </p>
              <a
                href={`/pilot-training/${homeBase.id.replace(/\.mdx?$/, "")}/`}
                class="mt-8 inline-block w-fit bg-[#4b7992] text-white font-bold py-3 px-8 rounded-full hover:bg-[#3a5f73] transition-all duration-300"
              >
                Visit Our Base &rarr;
              </a>
            </div>
            <div class="bg-[#5d4d40] flex items-center justify-center p-10">
              <div class="text-center">
                <p class="text-7xl font-bold text-white/10">KIXD</p>
                <p class="text-[#dcc1a6] uppercase tracking-widest mt-2 font-medium">
                  New Century AirCenter
                </p>
              </div>
            </div>
          </div>
        </div>
      )
    }

    <div class="mb-10">
      <h2 class="text-3xl font-bold text-[#423731] mb-8">
        Serving Surrounding Communities
      </h2>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          otherLocations.map((location) => (
            <a
              href={`/pilot-training/${location.id.replace(/\.mdx?$/, "")}/`}
              class="group relative overflow-hidden rounded-[1.5rem] border border-[#dcc1a6]/30 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1 hover:border-[#4b7992]"
            >
              <div class="absolute -top-5 -right-5 p-6 transition-opacity">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="opacity-10 group-hover:opacity-30 w-20 h-20 transition-opacity text-accent-500"
                >
                  <path
                    fill="currentColor"
                    fill-opacity="0"
                    stroke="currentColor"
                    stroke-dasharray="60"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 19h11c2.21 0 4 -1.79 4 -4c0 -2.21 -1.79 -4 -4 -4h-1v-1c0 -2.76 -2.24 -5 -5 -5c-2.42 0 -4.44 1.72 -4.9 4h-0.1c-2.76 0 -5 2.24 -5 5c0 2.76 2.24 5 5 5Z"
                  >
                    <animate
                      attributeName="d"
                      dur="12s"
                      keyTimes="0;0.25;0.5;0.75;1"
                      repeatCount="indefinite"
                      values="M7 19h11c2.21 0 4 -1.79 4 -4c0 -2.21 -1.79 -4 -4 -4h-1v-1c0 -2.76 -2.24 -5 -5 -5c-2.42 0 -4.44 1.72 -4.9 4h-0.1c-2.76 0 -5 2.24 -5 5c0 2.76 2.24 5 5 5Z;M6 19h12c2.21 0 4 -1.79 4 -4c0 -2.21 -1.79 -4 -4 -4h0v-1c0 -2.76 -2.24 -5 -5 -5c-2.42 0 -4.44 1.72 -4.9 4h-2.1c-2.76 0 -5 2.24 -5 5c0 2.76 2.24 5 5 5Z;M6 19h11c2.21 0 4 -1.79 4 -4c0 -2.21 -1.79 -4 -4 -4h0v-1c0 -2.76 -2.24 -5 -5 -5c-2.42 0 -4.44 1.72 -4.9 4h-1.1c-2.76 0 -5 2.24 -5 5c0 2.76 2.24 5 5 5Z;M7 19h10c2.21 0 4 -1.79 4 -4c0 -2.21 -1.79 -4 -4 -4h0v-1c0 -2.76 -2.24 -5 -5 -5c-2.42 0 -4.44 1.72 -4.9 4h-0.1c-2.76 0 -5 2.24 -5 5c0 2.76 2.24 5 5 5Z;M7 19h11c2.21 0 4 -1.79 4 -4c0 -2.21 -1.79 -4 -4 -4h-1v-1c0 -2.76 -2.24 -5 -5 -5c-2.42 0 -4.44 1.72 -4.9 4h-0.1c-2.76 0 -5 2.24 -5 5c0 2.76 2.24 5 5 5Z"
                    />
                    <animate
                      fill="freeze"
                      attributeName="stroke-dashoffset"
                      dur="0.6s"
                      values="60;0"
                    />
                    <animate
                      fill="freeze"
                      attributeName="fill-opacity"
                      begin="0.6s"
                      dur="0.4s"
                      to="1"
                    />
                  </path>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-[#423731]">
                {location.data.city}
              </h3>
              <p class="mt-3 text-[#5d4d40]/70 leading-relaxed">
                Serving {location.data.city} pilots with professional flight
                instruction just {location.data.distance} from our central hub.
              </p>
              <div class="mt-6 inline-flex items-center font-bold text-[#4b7992] group-hover:gap-2 transition-all">
                Explore Training <span class="ml-1">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <MapLocation />

  <AreasServed />
  <CTARight />

  <Enroll />
</BaseLayout>
