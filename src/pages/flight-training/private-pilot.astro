---

<BaseLayout
  siteTitle={data.siteTitle}
  siteDescription={data.siteDescription}
  siteKeywords={data.siteKeywords}
>
  <HeaderMain
    content={data.header}
    mainSize={false}
    showButton={false}
    images={[data.header.image]}
  />

  <ProgramsComponentDesign program={data.program} />
  <OffersStripCTA />
  <!-- <ProgramsComponent content={data.program} /> -->
  <FleetGallery
    fleet={fleet}
    selfLink={false}
    button={{
      title: "Start Your Journey",
      path: `#${website_links.enroll.id}`,
    }}
  />
  <SimulatorImageSection />
  <Enroll />
  <CTALeft content={data.ctas.ctaDiscoveryFlight} />
  <OffersSection />
  <CTARight content={data.ctas.ctaPrivatePilot} />
</BaseLayout>
