      "Training designed to help you advance with confidence and clarity.",
    ],
    bullets: [
      {
        icon: "",
        title: "Experienced Instructors",
        description:
          "Train with senior CFIs who prioritize your success, not building hours.",
      },
      {
        icon: "",
        title: "Safety-Focused Training",
        description:
          "Every lesson emphasizes procedures, judgment, and real-world preparedness.",
      },
      {
        icon: "",
        title: "Progress With Confidence",
        description:
          "Structured, transparent training paths that take you from day one to the flight deck.",
      },
    ],
    button: {
      text: "Enroll today",
      href: "#enroll",
    },

    programs: [
      {
        title: "Private Pilot License (PPL)",
