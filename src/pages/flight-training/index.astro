---

<BaseLayout
  siteTitle={data.siteTitle}
  siteDescription={data.siteDescription}
  siteKeywords={data.siteKeywords}
>
  <HeaderMain content={data.header} />
  <TextIcons content={data.overview} />

  <section class="py-12 bg-primary-300 relative overflow-hidden">
    <div class="mx-auto bg-logo-dark">
      <div class="text-white max-w-7xl mx-auto py-12">
        <div
          class="flex flex-col px-8 py-12 sm:px-12 text-center justify-center"
        >
          <span
            data-aos="zoom-in"
            data-aos-delay="300"
            data-aos-duration="1500"
          >
            {data.programs.upperHeader}
          </span>
          <h2
            class="text-4xl font-semibold tracking-tight text-pretty sm:text-5xl"
            data-aos="zoom-in"
            data-aos-duration="1500"
          >
            {data.programs.title}
          </h2>
          <p
            class="text-lg/8 text-pretty py-2 mt-6 border-b border-t text-white"
            data-aos="zoom-in"
            data-aos-delay="700"
            data-aos-duration="1500"
          >
            {data.programs.description}
          </p>
          <ul
            class="flex flex-col lg:flex-row items-center justify-center lg:justify-between gap-2 py-6"
            data-aos="zoom-in"
            data-aos-delay="700"
            data-aos-duration="1500"
          >
            {
              data.programs.bullets.map((bullet: any) => (
                <div class=" flex flex-col justify-center lg:w-1/4 ">
                  <div class="mb-4 text-white">
                    <svg
                      class="w-8 h-8 mx-auto"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d={bullet.icon || "M5 13l4 4L19 7"}
                      />
                    </svg>
                  </div>
                  <h3 class="font-semibold text-center mb-2 uppercase">
                    {bullet.title}
                  </h3>
                  <p class="text-white text-sm text-center">
                    {bullet.description}
                  </p>
                </div>
              ))
            }
          </ul>
          <div class="mt-10 flex mx-auto pointer-events-auto">
            <a href={data.programs.button.href} class="btn-accent btn-middle">
              {data.programs.button.text}
            </a>
          </div>
        </div>
      </div>
    </div>
    <section
      class="flex flex-col flex-wrap md:flex-row justify-center items-center gap-8 px-6 lg:px-0 py-12 max-w-7xl mx-auto"
    >
      {
        data.programs.programs.map((program) => (
          <CardProgram content={program} />
        ))
      }
    </section>
  </section>

  <CTAAirlineTrack />
  <!-- <CTALeft content={data.cta} /> -->
  <!-- <CTARight /> -->
  <Enroll />
  <FleetGallery fleet={fleet} selfLink={false} />
</BaseLayout>
