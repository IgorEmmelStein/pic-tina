  cta: {
    image: {
      src: "/src/assets/eliezer-fernandes-y7E8qfllcY0-unsplash.jpg",
      alt: "Aircraft exterior by Eliezer Fernandes",
    },
    title: "Ready to Get Started?",
    description:
      "Contact us today to enroll or speak with one of our senior instructors. We’ll guide you through every step toward earning your wings.",
    button: {
      text: "Contact Us",
      href: "/contact/",
    },
  },

  ctas: {
    ctaFloating: {
      upperHeading: "Train With Confidence",
      title: "High-Quality Instruction From Experienced CFIs",
      description:
        "Pilot Instructional Center offers aircraft-based training with a strong focus on safety, integrity, and real-world aviation excellence. Join a flight school committed to helping every student succeed.",
      images: [
        {
          src: "/src/assets/student using simulator 2.jpg",
          alt: "Student receiving flight instruction",
