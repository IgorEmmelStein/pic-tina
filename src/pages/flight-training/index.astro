---
import CTALeft from "../../components/ctas/CTALeft.astro";
import CTARight from "../../components/ctas/CTARight.astro";
import Enroll from "../../components/forms/Enroll.astro";
import HeaderMain from "../../components/headers/HeaderMainAlternative.astro";
import FAQ from "../../components/sections/FAQ.astro";
import TextIcons from "../../components/sections/TextIcons.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../data/consts";
import BaseLayout from "../../layouts/BaseLayout.astro";

import "aos/dist/aos.css";
import ContentMiddle from "../../components/content/ContentMiddle.astro";
import CardProgram from "../../components/cards/CardProgram.astro";
import CTAAirlineTrack from "../../components/ctas/CTAAirlineTrack.astro";
import FleetGallery from "../../components/fleet/FleetGallery.astro";
import { fleet } from "../about/our-fleet.astro";

