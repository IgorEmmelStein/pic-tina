          "Your foundation in aviation. Learn fundamental aircraft control, navigation, communications, and safe decision-making.",
        image: {
          src: "/src/assets/stock/stock_plane-ground-pilot_steward-masweneng-n9By7oBszM0-unsplash.jpg",
          alt: "Pilot standing by aircraft on ground by Steward Masweneng",
        },
        tags: ["Part 61", "PPL", "Beginner"],
        button: { title: "Explore", href: "/flight-training/private-pilot/" },
