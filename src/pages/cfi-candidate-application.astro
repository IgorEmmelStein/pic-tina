---

<BaseLayout
  siteTitle={data.siteTitle}
  siteDescription={data.siteDescription}
  siteKeywords={data.siteKeywords}
>
  <HeaderMain
    content={data.header}
    mainSize={false}
    showButton={false}
    images={[data.header.image]}
    button={data.header.button}
  />

  <ListComponent content={JoinOurTeam} />
  <ContentRight content={WhatMakesaGreatPICInstructor} />
  <ListComponent content={MinimumQualifications} />
  <div id="form">
    <CFIConfirmationForm />
  </div>
  <MapLocation />
  <FAQ />
</BaseLayout>