---
import ImageComp from "../utils/ImageComp.astro";

const { content } = Astro.props;
---

<section class="bg-[#fcfaf8] py-24 font-sans overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2
        class="text-4xl font-bold tracking-tight text-[#423731] sm:text-5xl uppercase leading-[1.1]"
        set:html={content.title}
      />
      <div class="mt-6 h-1.5 w-24 bg-[#4b7992] rounded-full"></div>
      <p class="mt-8 text-lg leading-8 text-[#5d4d40]/80">
        {content.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        content.cards.map((card) => (
          <div class="group flex flex-col bg-white rounded-3xl p-4 shadow-sm border border-neutral-100 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2">
            <div class="relative aspect-video lg:aspect-square overflow-hidden rounded-2xl mb-6">
              <svg
                class="absolute inset-0 w-full h-full z-50 pointer-events-none"
                fill="none"
              >
                <rect
                  x="2"
                  y="2"
                  rx="14"
                  width="calc(100% - 4px)"
                  height="calc(100% - 4px)"
                  class="stroke-[#4b7992] stroke-[4px] opacity-0 transition-all duration-700 group-hover:opacity-100"
                  style="stroke-dasharray: 2000; stroke-dashoffset: 2000;"
                />
              </svg>

              <ImageComp
                src={card.images[0].src}
                alt={card.images[0].alt}
                classes="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#423731]/30 to-transparent" />
            </div>

            <div class="px-4 pb-4 flex flex-col flex-grow">
              <h3 class="text-xl font-bold text-[#423731] uppercase tracking-tight mb-4">
                {card.title}
              </h3>

              <ul class="space-y-3 flex-grow">
                {card.bullets.map((bullet) => (
                  <li class="flex items-start gap-3 text-sm text-[#5d4d40]/70 leading-snug">
                    <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-[#4b7992]" />
                    {bullet}
                  </li>
                ))}
              </ul>

              <div class="mt-6 h-1 w-12 bg-[#4b7992] transition-all duration-500 group-hover:w-full rounded-full" />
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-20 flex justify-center text-center">
      <a
        href={content.cta.href}
        class="group relative inline-flex items-center justify-center px-10 py-5 bg-[#423731] text-white font-bold rounded-full overflow-hidden transition-all hover:bg-[#4b7992]"
      >
        <span class="relative z-10 uppercase tracking-[0.2em] text-sm"
          >{content.cta.text}</span
        >
        <div
          class="absolute bottom-0 left-0 h-1 bg-[#dcc1a6] w-0 transition-all duration-500 group-hover:w-full"
        >
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  /* SVG Animation matching your fleet logic */
  .group:hover rect {
    animation: drawBorderAdvantage 1.2s ease-in-out forwards;
  }

  @keyframes drawBorderAdvantage {
    from {
      stroke-dashoffset: 2000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
