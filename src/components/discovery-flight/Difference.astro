---
import ImageComp from "../utils/ImageComp.astro";

const { content } = Astro.props;
---

<section class="bg-[#fcfaf8] py-24 font-sans overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="order-2 lg:order-1">
        <h2
          class="text-4xl font-bold tracking-tight text-[#423731] sm:text-5xl uppercase leading-[1.1]"
          set:html={content.title}
        />
        <div class="mt-6 h-1.5 w-24 bg-[#4b7992] rounded-full"></div>

        <div class="mt-10 space-y-8">
          <div class="relative pl-8 border-l-2 border-[#dcc1a6]/30">
            <p
              class="text-xl leading-relaxed text-[#423731] font-medium italic"
            >
              {content.frameworkText}
            </p>
          </div>

          <p class="text-lg leading-8 text-[#5d4d40]/80">
            {content.proofText}
          </p>
        </div>

        <div class="mt-10 text-center">
          <a
            href={content.cta.href}
            class="group relative inline-flex items-center justify-center px-8 py-4 bg-[#4b7992] hover:text-[#4b7992] text-white font-bold rounded-full overflow-hidden transition-all hover:bg-[#dcc1a6]"
          >
            <span class="relative z-10 uppercase tracking-widest text-sm"
              >{content.cta.text}</span
            >
            <div
              class="absolute bottom-0 left-0 h-1 bg-[#4b7992] w-0 transition-all duration-500 group-hover:w-full"
            >
            </div>
          </a>
        </div>
        <div class="mt-12 flex items-center gap-6">
          <div
            class="h-px flex-grow bg-gradient-to-r from-[#4b7992] to-transparent"
          >
          </div>
          <span
            class="text-[10px] font-title uppercase tracking-[0.4em] text-[#4b7992] whitespace-nowrap"
          >
            Uncompromising Excellence
          </span>
        </div>
      </div>

      <div class="order-1 lg:order-2 group relative">
        <div
          class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-2xl shadow-neutral-900/20"
        >
          <svg
            class="absolute inset-0 w-full h-full z-30 pointer-events-none"
            fill="none"
          >
            <rect
              x="4"
              y="4"
              rx="20"
              width="calc(100% - 8px)"
              height="calc(100% - 8px)"
              class="stroke-[#4b7992] stroke-[6px] opacity-0 transition-all duration-700 group-hover:opacity-100"
              style="stroke-dasharray: 3000; stroke-dashoffset: 3000;"></rect>
          </svg>

          <ImageComp
            src={content.image}
            alt="PIC Training Standard"
            classes="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-[#423731]/40 via-transparent to-transparent"
          >
          </div>
        </div>

        <div
          class="absolute -top-4 -right-4 w-24 h-24 bg-[#dcc1a6]/10 rounded-full blur-3xl -z-10"
        >
        </div>
        <div
          class="absolute -bottom-4 -left-4 w-32 h-32 bg-[#4b7992]/5 rounded-full blur-3xl -z-10"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Animation for the border frame */
  .group:hover rect {
    animation: drawStandardBorder 1.5s ease-in-out forwards;
  }

  @keyframes drawStandardBorder {
    from {
      stroke-dashoffset: 3000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
