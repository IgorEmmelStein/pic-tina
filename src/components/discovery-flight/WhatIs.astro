---
import ImageComp from "../utils/ImageComp.astro";

const { content } = Astro.props;
const { title, paragraphs, image, note, cta, imageRight = false } = Astro.props;
---

<section class="relative bg-[#fcfaf8] py-24 overflow-hidden font-sans">
  <div class="absolute inset-0 z-0 opacity-5 pointer-events-none">
    <ImageComp
      src={content.bgImage.src}
      alt={content.bgImage.alt}
      classes="w-full h-full object-cover grayscale"
    />
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div
      class={`grid lg:grid-cols-2 gap-16 items-center ${content.imageRight ? "lg:ltr" : ""}`}
    >
      <div class={`${content.imageRight ? "lg:order-1" : "lg:order-2"}`}>
        <div class="max-w-xl">
          <h2
            class="text-4xl font-extrabold tracking-tight text-[#4b7992] sm:text-5xl uppercase leading-tight"
            set:html={content.title}
          />
          <div class="mt-6 h-1.5 w-20 bg-[#4b7992] rounded-full"></div>

          <div class="mt-8 space-y-6 text-lg leading-8 text-[#5d4d40]/80">
            {content.paragraphs.map((p) => <p set:html={p} />)}
          </div>

          <div
            class="mt-10 p-6 bg-white border-l-4 border-[#4b7992] rounded-r-2xl shadow-sm"
          >
            <h4
              class="text-[#423731] font-bold uppercase tracking-widest text-sm mb-1"
            >
              {content.note.title}
            </h4>
            <p class="text-[#5d4d40]/70 text-sm" set:html={content.note.text} />
          </div>

          <div class="mt-10 text-center">
            <a
              href={content.cta.href}
              class="group relative inline-flex items-center justify-center px-8 py-4 bg-[#4b7992] hover:text-[#4b7992] text-white font-bold rounded-full overflow-hidden transition-all hover:bg-[#dcc1a6]"
            >
              <span class="relative z-10 uppercase tracking-widest text-sm"
                >{content.cta.text}</span
              >
              <div
                class="absolute bottom-0 left-0 h-1 bg-[#4b7992] w-0 transition-all duration-500 group-hover:w-full"
              >
              </div>
            </a>
          </div>
        </div>
      </div>

      <div
        class={`relative group ${content.imageRight ? "lg:order-2" : "lg:order-1"}`}
      >
        <div
          class="relative aspect-square sm:aspect-video lg:aspect-4/5 overflow-hidden rounded-3xl shadow-2xl"
        >
          <svg
            class="absolute inset-0 w-full h-full z-30 pointer-events-none"
            fill="none"
          >
            <rect
              x="2"
              y="2"
              rx="22"
              width="calc(100% - 4px)"
              height="calc(100% - 4px)"
              class="stroke-[#4b7992] stroke-[6px] opacity-0 transition-all duration-700 group-hover:opacity-100"
              style="stroke-dasharray: 3000; stroke-dashoffset: 3000;"></rect>
          </svg>

          <ImageComp
            src={content.image.src}
            alt={content.image.alt}
            classes="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-[#423731]/40 via-transparent to-transparent"
          >
          </div>
        </div>

        <div
          class="absolute -bottom-6 -right-6 -z-10 w-32 h-32 bg-[#dcc1a6]/20 rounded-full blur-2xl"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .group:hover rect {
    animation: drawBorder 1.5s ease-in-out forwards;
  }

  @keyframes drawBorder {
    from {
      stroke-dashoffset: 3000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
