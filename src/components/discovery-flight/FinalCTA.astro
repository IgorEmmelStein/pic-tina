---
const { content } = Astro.props;
---

<section class="relative bg-[#fcfaf8] py-24 px-6 overflow-hidden font-sans">
  <div class="max-w-7xl mx-auto">
    <div
      class="relative bg-[#4b7992] rounded-[2rem] p-8 md:p-16 lg:p-20 shadow-2xl overflow-hidden group"
    >
      <div
        class="absolute inset-0 opacity-10 pointer-events-none"
        style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 40px 40px;"
      >
      </div>

      <div class="relative z-10 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2
            class="text-3xl md:text-5xl font-bold text-white uppercase leading-tight tracking-tight"
          >
            {content.title}
          </h2>
          <div
            class="mt-8 h-1.5 w-24 bg-[#423731] rounded-full transition-all duration-700 group-hover:w-48"
          >
          </div>
          <p
            class="mt-8 text-lg md:text-xl text-white/90 leading-relaxed max-w-xl"
          >
            {content.description}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-6">
          <a
            href={content.primaryCTA.href}
            class="group/btn relative inline-flex items-center justify-center px-10 py-5 bg-white text-[#423731] hover:text-[#dcc1a6] border border-[#dcc1a6] font-bold rounded-xl uppercase tracking-widest text-sm transition-all hover:bg-[#4b7992] hover:text-[#423731] overflow-hidden"
          >
            <span class="relative z-10">{content.primaryCTA.text}</span>
            <div
              class="absolute bottom-0 left-0 h-1 bg-[#423731] w-0 transition-all duration-500 group-hover/btn:w-full"
            >
            </div>
          </a>

          <a
            href={content.secondaryCTA.href}
            class="group/btn relative inline-flex items-center justify-center px-10 py-5 border-2 border-white/40 text-white font-bold rounded-xl uppercase tracking-widest text-sm transition-all hover:border-white hover:bg-white/5 overflow-hidden"
          >
            <span class="relative z-10">{content.secondaryCTA.text}</span>
            <div
              class="absolute bottom-0 left-0 h-1 bg-[#dcc1a6] w-0 transition-all duration-500 group-hover/btn:w-full"
            >
            </div>
          </a>
        </div>
      </div>

      <svg
        class="absolute -right-12 -bottom-12 w-64 h-64 text-white/5 -rotate-12 transition-transform duration-1000 group-hover:scale-110 group-hover:rotate-0"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
        ></path>
      </svg>
    </div>

    <div class="mt-12 text-center">
      <p
        class="text-[10px] font-title uppercase tracking-[0.5em] text-[#423731]/30"
      >
        Pilot Instructional Center &bull; Professional Mentorship &bull; Real
        Aviation
      </p>
    </div>
  </div>
</section>
