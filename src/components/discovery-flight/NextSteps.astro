---
import { AIRPORT } from "../../data/consts";

const { content } = Astro.props;
---

<section class="bg-[#fcfaf8] py-24 font-sans overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center mb-20">
      <h2
        class="text-4xl font-bold tracking-tight text-[#423731] sm:text-5xl uppercase leading-tight"
        set:html={content.title}
      />
      <div class="mt-6 h-1.5 w-24 bg-[#4b7992] mx-auto rounded-full"></div>
      <p class="mt-8 text-lg text-[#5d4d40]/70 max-w-2xl mx-auto">
        {content.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <div
        class="hidden md:block absolute top-1/2 left-0 w-full h-px border-t-2 border-dashed border-[#4b7992]/20 -z-0"
      >
      </div>

      {
        content.cards.map((card) => (
          <div class="group relative z-10 flex flex-col bg-white rounded-3xl p-8 shadow-sm border border-neutral-100 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2">
            <div class="mb-8 flex items-center justify-between">
              <div class="w-14 h-14 rounded-2xl bg-[#4b7992] text-white flex items-center justify-center text-2xl font-black shadow-lg shadow-[#4b7992]/20 group-hover:scale-110 transition-transform duration-500">
                {card.number}
              </div>
              <div class="h-px flex-grow ml-4 bg-[#dcc1a6]/30 group-hover:bg-[#4b7992]/30 transition-colors" />
            </div>

            <h3 class="text-xl font-bold text-[#423731] uppercase tracking-tight mb-4">
              {card.title}
            </h3>

            <p class="text-[#5d4d40]/70 leading-relaxed flex-grow mb-8">
              {/* Handling the AIRPORT variable in the string */}
              {card.description.replace("${AIRPORT}", AIRPORT)}
            </p>

            <a
              href={card.cta.href}
              class="group/btn relative w-full overflow-hidden bg-[#423731] text-white text-center font-bold py-4 rounded-xl uppercase tracking-widest text-xs transition-all hover:bg-[#4b7992]"
            >
              <span class="relative z-10">{card.cta.text}</span>
              <div class="absolute bottom-0 left-0 h-1 bg-[#dcc1a6] w-0 transition-all duration-500 group-hover/btn:w-full" />
            </a>
          </div>
        ))
      }
    </div>
    <div class="mt-10 text-center">
      <a
        href={content.cta.href}
        class="group relative inline-flex items-center justify-center px-8 py-4 bg-[#4b7992] hover:text-[#4b7992] text-white font-bold rounded-full overflow-hidden transition-all hover:bg-[#dcc1a6]"
      >
        <span class="relative z-10 uppercase tracking-widest text-sm"
          >{content.cta.text}</span
        >
        <div
          class="absolute bottom-0 left-0 h-1 bg-[#4b7992] w-0 transition-all duration-500 group-hover:w-full"
        >
        </div>
      </a>
    </div>
    <div class="mt-16 text-center">
      <p
        class="text-[10px] font-black uppercase tracking-[0.4em] text-[#423731]/40"
      >
        Professional Mentorship From Day One
      </p>
    </div>
  </div>
</section>
