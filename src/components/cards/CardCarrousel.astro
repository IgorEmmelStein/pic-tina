---
import ImageComp from "../utils/ImageComp.astro";

const example = {
  title: "Private Pilot License",
  description:
    "Start your aviation journey by learning to fly for recreation or as the first step toward a flying career.",
  image: {
    src: "/src/assets/stock/stock-joao-lopes-S2ftkdYZGM0-unsplash.jpg",
    alt: "Plane Taking off",
  },
  tags: ["Part 61", "PPL", "PPC"],
  button: { title: "Explore", href: "/flight-training/private-pilot/" },
};

const { content = example } = Astro.props;
---

<a
  href={content.button.href}
  target="_self"
  class="group relative flex flex-col justify-around rounded-4xl h-[70vh] lg:h-[40vh] w-full lg:w-1/3 shrink-0 text-white shadow-xl inset-shadow-2xs shadow-black/90 border-8 border-primary-300 transition-transform duration-300 ease-out hover:border-primary-800 md:hover:scale-105"
>
  <!-- IMAGE -->
  <div class="absolute inset-0 w-full h-full overflow-hidden rounded-3xl">
    <ImageComp
      src={content.image.src}
      alt={content.image.alt}
      classes="h-full w-full object-cover group-hover:blur-sm group-hover:-translate-y-3 group-hover:scale-110 duration-150 ease-out"
      quality={60}
    />

    <div
      class="absolute inset-0 bg-primary-900/70 lg:bg-primary-600/45 group-hover:bg-primary-900/70 duration-500"
    >
    </div>
  </div>

  <div
    class="flex flex-col z-10 items-center justify-center text-center"
    data-aos="zoom-in"
  >
    <p
      class="text-pretty text-primary-800 text-xl lg:max-w-[90%] bg-white/40 backdrop-blur-sm px-6 py-4 rounded-full font-semibold drop-shadow-md leading-7 transition-all duration-500 ease-in-out uppercase"
      set:html={content.title}
    />
    <p
      class="text-xs text-primary-800 hidden lg:block"
      set:html={content.description}
    />
  </div>
</a>
