---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

const { title = "On this page", headings = [] } = Astro.props as {
  title?: string;
  headings?: Heading[];
};

// Only keep h2–h4 (optional)
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{
  filtered.length > 0 && (
    <aside class="hidden w-full min-w-0 flex-col gap-12 rounded-md border border-gray-300 bg-white p-6 text-gray-950 lg:flex">
      <section>
        <h2 class="text-2xl font-bold text-primary-950">{title}</h2>

        <hr class="mt-1 mb-4 h-0.5 rounded-full border-none bg-accent-500" />

        <ul class="space-y-3">
          {filtered.map((heading) => (
            <li class:list={["min-w-0", heading.depth > 2 && "pl-4"]}>
              <div class="flex min-w-0 items-start gap-3 text-base font-semibold leading-tight transition-colors duration-300 ease-in-out hover:text-accent-500">
                <span class="mt-2 size-2 shrink-0 rounded-full bg-accent-500" />
                <span class="min-w-0 break-words">{heading.text}</span>
              </div>

              {/* <a
                href={`#${heading.slug}`}
                class="flex min-w-0 items-start gap-3 text-base font-semibold leading-tight transition-colors duration-300 ease-in-out hover:text-accent-500"
              >
                <span class="mt-2 size-2 shrink-0 rounded-full bg-accent-500" />
                <span class="min-w-0 break-words">{heading.text}</span>
              </a> */}
            </li>
          ))}
        </ul>
      </section>
    </aside>
  )
}
