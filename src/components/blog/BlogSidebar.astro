---
import { getCollection } from "astro:content";
import { slugify } from "./utils";
import BlogSearch from "./BlogSearch.astro";

const allPosts = await getCollection("blog");

// 1. Recent Posts
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// 2. Categories with actual Enum counts
const categoryCounts = new Map();
allPosts.forEach((post) => {
  const cats = post.data.categories || ["Uncategorized"];
  cats.forEach((cat) => {
    categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
  });
});

// 3. Tags for the cloud
const allTags = [
  ...new Set(allPosts.map((post) => post.data.tags || []).flat()),
];
---

<aside id="primary-sidebar" class="flex flex-col gap-10">
  <BlogSearch tags={allTags} />

  <section class="widget">
    <h2
      class="text-lg font-bold text-madison-950 mb-5 pb-2 border-b-2 border-accent-700"
    >
      Recent Posts
    </h2>
    <ul class="space-y-4">
      {
        recentPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`} class="group flex flex-col gap-1">
              <span class="text-sm font-medium leading-tight group-hover:text-accent-700 transition-colors">
                {post.data.title}
              </span>
              <span class="text-[11px] text-gray-400 uppercase tracking-widest">
                {post.data.pubDate.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="widget">
    <h2
      class="text-lg font-bold text-madison-950 mb-5 pb-2 border-b-2 border-accent-700"
    >
      Categories
    </h2>
    <ul class="space-y-2">
      {
        [...categoryCounts.entries()].sort().map(([name, count]) => (
          <li class="group">
            <a
              href={`/blog/category/${slugify(name)}/`}
              class="flex justify-between items-center text-sm text-gray-600 hover:text-accent-700 py-1 transition-all"
            >
              <span>{name}</span>
              <span class="bg-gray-100 group-hover:bg-accent-700 group-hover:text-white px-2 py-0.5 rounded-full text-[10px] font-bold transition-colors">
                {count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="widget">
    <h2
      class="text-lg font-bold text-madison-950 mb-5 pb-2 border-b-2 border-accent-700"
    >
      Tags
    </h2>
    <div class="flex flex-wrap gap-2">
      {
        allTags.map((tag) => (
          <a
            href={`/blog/tag/${slugify(tag)}/`}
            class="text-[11px] uppercase tracking-wider px-3 py-1.5 bg-white border border-gray-200 text-gray-500 hover:bg-accent-700 hover:border-accent-700 hover:text-white transition-all rounded-sm"
          >
            {tag}
          </a>
        ))
      }
    </div>
  </section>
</aside>
