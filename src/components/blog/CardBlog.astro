---
// Import necessary components and utilities
import AvatarBlog from "./AvatarBlog.astro";
import { Image } from "astro:assets";
import { formatDate } from "../../components/utils/utils";
import type { CollectionEntry } from "astro:content";
import ImageComp from "../utils/ImageComp.astro";

const { blogEntry, blogLocale = "", index } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<"blog">;
  blogLocale?: string;
  index?: number;
}
---

<!-- The following anchor tag is the main container for the card.
     It's a link to the blog post detailed page.
     The data-astro-prefetch is an Astro specific Dynamic HTML feature,
     which automatically prefetches the linked page to speed up navigation. -->
<a
  class="group relative block rounded-xl outline-hidden transition duration-500 focus-visible:ring-3 hover:ring-primary-400 hover:ring-4"
  href={blogLocale && blogLocale !== "en"
    ? `/${blogLocale}/blog/${blogEntry.slug.replace(/^fr\//, "")}/`
    : `/blog/${blogEntry.slug.replace(/^en\//, "")}/`}
  data-astro-prefetch
  data-post-card
  data-title={blogEntry.data.title}
  data-description={blogEntry.data.description}
>
  <!-- The container for the blog post's cover image. Uses astro:assets' Image for image source -->
  <div
    class="relative h-[350px] lg:h-[450px] w-full shrink-0 overflow-hidden rounded-xl before:absolute before:inset-x-0 before:z-1 before:size-full before:bg-linear-to-t before:from-neutral-900/70"
  >
    <!-- <Image
      class="absolute start-0 top-0 size-full object-cover transition duration-500 group-hover:scale-110"
      src={blogEntry.data.cardImage}
      alt={blogEntry.data.cardImageAlt}
      draggable={"false"}
      loading={"eager"}
      format={"avif"}
    /> -->
    <ImageComp
      classes="absolute start-0 top-0 size-full object-cover transition duration-500 group-hover:scale-110"
      src={blogEntry.data.cardImage}
      alt={blogEntry.data.cardImageAlt}
      loading={"eager"}
    />
    <!-- Translucent overlay -->
    <div class="absolute inset-0 bg-neutral-900/40"></div>
  </div>
  <!-- The container for the blog author's avatar and associated metadata (author name and publication date) -->
  <div class="absolute inset-x-0 top-0 z-10">
    <div class="flex h-full flex-col p-4 sm:p-6">
      <div class="flex items-center">
        <AvatarBlog blogEntry={blogEntry} />

        <div class="ms-2.5 sm:ms-4">
          <p class="font-bold text-neutral-50">
            {blogEntry.data.author}
          </p>
          <p class="text-xs text-neutral-50/80">
            {formatDate(blogEntry.data.pubDate)}
          </p>
        </div>
      </div>
    </div>
  </div>
  <!-- The container for the blog post's title and description -->
  <div class="absolute inset-x-0 bottom-0 z-10">
    <div class="flex h-full flex-col p-4 sm:p-6">
      <h2
        class="text-balance text-lg font-bold text-white group-hover:text-primary-400 sm:text-3xl"
      >
        {blogEntry.data.title}
      </h2>
      <p class="mt-2 text-pretty text-neutral-50/80">
        {blogEntry.data.description}
      </p>
    </div>
  </div>
</a>
