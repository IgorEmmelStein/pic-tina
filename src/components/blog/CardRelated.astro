---
import { Image } from "astro:assets";
import { formatDate } from "../../components/utils/utils";
import type { CollectionEntry } from "astro:content";
import ImageComp from "../utils/ImageComp.astro";

const { blogEntry, recentBlogLocale = "", index } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<"blog">;
  recentBlogLocale?: string;
  index?: number;
}
---

<a
  class="group hover:scale-105 rounded-full block ring-zinc-500 outline-hidden transition duration-500 focus-visible:ring-3"
  href={recentBlogLocale && recentBlogLocale !== "en"
    ? `/${recentBlogLocale}/blog/${blogEntry.slug.replace(/^fr\//, "")}/`
    : `/blog/${blogEntry.slug.replace(/^en\//, "")}/`}
  data-astro-prefetch
>
  <div
    class=`flex flex-col h-full justify-between group-first:items-end  ${index === 1 ? "items-center": ""}`
  >
    <ImageComp
      classes="aspect video h-42 object-cover shadow-lg shadow-black/30 ring ring-primary-600 group-first:rounded-tl-full group-first:rounded-bl-full group-last:rounded-tr-full group-last:rounded-br-full "
      src={blogEntry.data.cardImage}
      alt={blogEntry.data.cardImageAlt}
    />
    <!-- The title of the blog post -->
    <h3
      class="group-first:text-right text-center group-last:text-left text-primary-600 mt-2 text-lg font-medium text-balance group-hover:text-neutral-900"
    >
      {blogEntry.data.title}
    </h3>
    <!-- The formatted publication date of the blog post -->
    <p
      class="mt-2 text-sm group-first:text-right group-last:text-left text-primary-600"
    >
      {formatDate(blogEntry.data.pubDate)}
    </p>
  </div>
</a>
