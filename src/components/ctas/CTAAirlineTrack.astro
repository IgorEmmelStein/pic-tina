---
import ImageComp from "../utils/ImageComp.astro";

const example = {
  image: {
    src: "/src/assets/eliezer-fernandes-y7E8qfllcY0-unsplash.jpg",
    alt: "Commercial airliner on the runway by Eliezer Fernandes",
  },
  title: "Ready to Start Your Airline Pilot Career?",
  description:
    "Take the next step toward the flight deck. Talk with our team about a structured training path designed to take you from your first flight to airline eligibility with integrity.",
  button: {
    text: "Explore the Airline Pilot Track",
    href: "/airline-pilot-track/",
  },
};

const { content = example } = Astro.props;
---

<section class="relative bg-[#fcfaf8] py-20 lg:py-32 overflow-hidden">
  <div
    class="absolute top-0 left-0 w-full h-full opacity-[0.03] pointer-events-none select-none overflow-hidden"
  >
    <span
      class="text-[20rem] font-black text-[#423731] absolute -top-20 -left-20 italic"
      >JET</span
    >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7" data-aos="fade-right">
        <div class="inline-flex items-center gap-2 mb-6">
          <div class="w-10 h-[2px] bg-[#dcc1a6]"></div>
          <span
            class="text-[#745e4d] font-black uppercase tracking-[0.3em] text-xs"
            >Professional Path</span
          >
        </div>

        <h2
          class="text-4xl md:text-6xl lg:text-7xl font-black text-[#423731] leading-[1.1] mb-8"
        >
          {content.title}
        </h2>

        <p
          class="text-lg md:text-xl text-[#745e4d] leading-relaxed mb-10 max-w-xl"
        >
          {content.description}
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href={content.button.href}
            class="bg-[#423731] text-[#dcc1a6] px-10 py-5 rounded-full font-black uppercase tracking-widest text-sm hover:bg-[#745e4d] hover:text-white transition-all transform hover:-translate-y-1 shadow-2xl"
          >
            {content.button.text}
          </a>

          <a
            href="/contact/"
            class="px-10 py-5 rounded-full font-black uppercase tracking-widest text-sm text-[#423731] border-2 border-[#dcc1a6] hover:bg-[#fcfaf8] transition-all"
          >
            Talk to an Advisor
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 relative" data-aos="fade-left">
        <div class="relative group">
          <div
            class="rounded-l-full overflow-hidden border-[12px] border-white shadow-2xl"
          >
            <ImageComp
              src={content.image.src}
              alt={content.image.alt}
              classes="h-full w-full object-cover group-hover:scale-110 transition-transform duration-1000 ease-out"
              quality={80}
            />
            <div
              class="absolute inset-0 group-hover:bg-transparent transition-colors duration-500"
            >
            </div>
          </div>

          <div
            class="absolute -bottom-6 -left-6 bg-[#dcc1a6] text-[#423731] p-6 rounded-3xl shadow-xl hidden md:block"
            data-aos="zoom-in"
            data-aos-delay="500"
          >
            <p
              class="text-xs font-black uppercase tracking-widest leading-none mb-1"
            >
              Total Time
            </p>
            <p class="text-3xl font-black italic">1,500 HRS</p>
            <p class="text-[10px] font-bold opacity-70">
              Airline Eligibility Goal
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
