---
import ImageComp from "../utils/ImageComp.astro";

const example = {
  upperHeading: "Meet our team",
  title: "Leadership Members",
  description: "Our leadership team is committed to fostering a culture of innovation, safety, and excellence in aviation education, ensuring that our students receive the best possible training and support.",
  descriptions: [
    "Over the years, Stephanie has worn many hats in the industry, serving as a Customer Service Manager, Line Service Manager, Charter Scheduler, and Flight School Operations Manager.",
    "While she enjoyed each role, she found the greatest fulfillment in her work with the Flight School. Being part of the students’ journeys, helping them turn their dreams of flying into reality, has always been especially meaningful to her.",
    "Watching students grow is what Stephanie finds most rewarding. From their very first flight, to becoming flight instructors, and eventually moving on to charter companies or the airlines, she takes great pride in seeing their progress and celebrating their achievements.",
  ],
  team: [
    {
      name: "Stephanie Fahy",
      role: "Founder & CEO",
      description: "Stephanie has been in the aviation industry for over 30 years, with more than 15 of those spent in the Johnson County area. She began her aviation career working alongside her father, helping him operate his FBO in Hays, Kansas.",
      image: {
        src: "/src/assets/team/team-PIC_Stephanie Fahy_Flight-School_Pilot-Training_Pilot-Instructional-Center.png",
        alt: "Stephanie Fahy",
      },
    },
  ],
};

const { content = example } = Astro.props;
---

<div class="bg-logo-dark py-24 md:py-32 relative font-sans">
  <div class="mx-auto flex flex-col max-w-7xl px-6 lg:px-8">
    <span class="text-2xl text-white uppercase" data-aos="fade-right" data-aos-duration="1500">
      {content.upperHeading}
    </span>
    <h2 class="flex text-4xl font-semibold tracking-tight text-pretty pb-12 pt-6 sm:text-5xl lg:text-7xl text-white uppercase" data-aos="fade-right" data-aos-duration="1500">
      {content.title}
    </h2>
    
    {content.descriptions?.[0] && (
      <p class="text-white text-xl text-left lg:max-w-1/2 border-t border-white/90 pt-6 font-light" data-aos="fade-right" data-aos-duration="1000">
        {content.descriptions[0]}
      </p>
    )}

    <ul role="list" class="group mt-12 space-y-16">
      {
        content.team.map((member: any, index: number) => (
          index % 2 === 0 ? (
            <div class="flex flex-col-reverse lg:flex-row justify-end items-center text-left gap-12">
              <div class="flex flex-col justify-center items-center max-w-xl py-12 text-white lg:w-1/3">
                {
                  content.descriptions?.slice(1, 3).map((desc: string) => (
                    <p class="mt-6 lg:mt-0 text-2xl lg:text-lg py-6 font-light" data-aos="fade-right" data-aos-duration="1000">
                      {desc}
                    </p>
                  ))
                }
              </div>
              <li class="flex flex-col py-24 mt-6 px-12 items-center gap-4 bg-primary-300 rounded-[8em] ring ring-white/90 sm:py-32 sm:px-24 md:flex-row md:rounded-[12em] lg:mt-0 lg:pl-44 lg:w-2/3 lg:py-12 lg:rounded-tl-full lg:rounded-bl-full lg:rounded-tr-none lg:rounded-br-none list-none">
                {member.image?.src && (
                  <ImageComp 
                    src={member.image.src}
                    alt={member.image.alt || member.name}
                    classes="size-44 lg:size-52 rounded-full object-cover ring-2 ring-white shrink-0"
                  />
                )}
                <div class="max-w-xl flex-auto lg:py-12 lg:text-right">
                  <p class="text-lg text-white font-semibold" data-aos="fade-right" data-aos-duration="1500" data-aos-delay="300">
                    {member.role || member.roles}
                  </p>
                  <h3 class="text-3xl uppercase font-semibold tracking-tight text-white" data-aos="fade-left" data-aos-duration="1500">
                    {member.name}
                  </h3>
                  <p class="mt-6 text-base/7 text-white border-y border-white py-2 font-light" data-aos="fade-right" data-aos-duration="1500">
                    {member.description}
                  </p>
                </div>
              </li>
            </div>
          ) : (
            <div class="flex flex-col lg:flex-row justify-start items-start text-left text-white gap-12">
              <li class="flex flex-col justify-self-start w-full lg:w-1/2 items-center gap-10 py-12 sm:flex-row bg-primary-300 px-12 rounded-tr-full rounded-br-full ring ring-white/90 list-none">
                <div class="max-w-xl flex-auto py-12">
                  <h3 class="text-lg/8 font-semibold tracking-tight text-white uppercase">{member.name}</h3>
                  <p class="text-base/7 text-white font-semibold">{member.role || member.roles}</p>
                  <p class="mt-6 text-base/7 text-white font-light">{member.description}</p>
                </div>
                {member.image?.src && (
                  <ImageComp 
                    src={member.image.src}
                    alt={member.image.alt || member.name}
                    classes="w-52 h-52 rounded-full object-cover outline-1 -outline-offset-1 outline-black/5 shrink-0"
                  />
                )}
              </li>
              <div class="max-w-xl py-12 text-right">
                {content.descriptions?.[index] && (
                  <p class="mt-6 text-2xl font-light">{content.descriptions[index]}</p>
                )}
              </div>
            </div>
          )
        ))
      }
    </ul>

    {content.description && (
      <p class="text-white text-xl text-left lg:max-w-1/2 border-b border-white/90 pb-6 mt-16 font-light" data-aos="fade-right" data-aos-duration="1000">
        {content.description}
      </p>
    )}
  </div>
</div>