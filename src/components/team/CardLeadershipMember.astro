---
import ImageComp from '../utils/ImageComp.astro';
const example ={
    image: {
      src: "/src/assets/Placeholder_Pilot-Silhouette.png",
      alt: "Pilot Placeholder Silhouette",
    },
    roles: "Golden",
    name: "John Joe",
    description:
      "John Joe is a pilot with 30 years of experience in commercial aviation. He has flown for several major airlines and has a passion for teaching and mentoring new pilots.",
    socials: [
      {
        icon: "M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z",
        href: "https://facebook.com/johnjoe",
      },
      {
        icon: "M16 8a6 6 0 01-11.95 1H2v3h3v9h4v-9h3l1-3h-4V7a2 2 0 012-2h3z",
        href: "https://twitter.com/johnjoe",
      },
    ],
}

const { content = example } = Astro.props;
---

<li class="mx-auto flex max-w-7xl flex-col-reverse overflow-hidden md:flex-row relative">
    <div class=" flex-1 text-white">
        <div class="flex flex-col px-8 py-12 sm:px-12 w-3/4"  data-aos="zoom-in" data-aos-delay="300">
            <span>
                {content.roles}
            </span>
            <h2
            class="text-4xl font-semibold tracking-tight text-pretty sm:text-5xl"
            >
            {content.name}
            </h2>
            <p class="text-lg/8 text-pretty text-gray-300 py-2 mt-6 border-b border-t border-white/30 ">
            {content.description}
            </p>

            <ul class="flex flex-col lg:flex-row items-center justify-center lg:justify-between gap-12 py-12">
                {
                    content.socials.map((social: any) => (
                            <div class="group flex flex-row items-center gap-6 max-w-44 p-2 hover:border-y  rounded-sm hover:scale-110 transition-all duration-500 ease-in-out ">
                                
                                    <span class="text-3xl font-bold group-hover:scale-200  transition-all duration-300 ease-in-out ">⟨</span>  
                                <div class="flex flex-col mb-4 text-white">
                                    <svg
                                        class="w-8 h-8 mx-auto"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d={social.icon || "M5 13l4 4L19 7"}
                                        />
                                    </svg>
                                    <a href={social.href} class="font-semibold text-center my-4 uppercase">
                                        {social.name}
                                    </a>
                                </div>
                                <span class="text-3xl font-bold group-hover:scale-200  transition-all duration-300 ease-in-out ">⟩</span> 
                        </div>
                        ))
                }
            </ul>
        </div>
    </div>
    <div 
        class="lg:absolute inset-y-0 right-0 top-12 z-10  mt-12  flex justify-end"
        data-aos="fade-left"
        >
        <ImageComp
            src={content.image.src}
            alt={content.image.alt}
            classes="object-cover  w-full rounded-tl-full rounded-bl-full shadow-2xl shadow-black/80"
        />
    </div>
</li>
