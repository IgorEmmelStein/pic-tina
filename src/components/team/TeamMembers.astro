---
import ImageComp from "../utils/ImageComp.astro";

const example = {
      upperHeading: "Meet our team",
      title: "Our CFI Team",
      description:" Our Certified Flight Instructors (CFIs) are passionate aviators dedicated to providing top-notch flight training to aspiring pilots.",
      team: [
        {
          name: "Logan Fahy",
          description: "Logan began flying in 2022 and became an instructor in 2024. Logan has instructed for over 1000 hours and is a contract pilot with Kansas University Athletics, flying the Cessna Citation CJ4. Logan’s favorite part about instructing is watching his students get their licenses and achieve their dreams.",
          roles: "Chief Safety Officer / Advanced Flight Instructor",
          tags: "CFI, CFII, CE-525 SIC",
          image: {
            src: "/src/assets/team/CFI-Logan-Fahy_PIC_Flight-School_Pilot-Training_Pilot-Instructional-Center.png",
            alt: "",
          
          },
        },
        {
          name: "Ryan Tindall",
          description: "Ryan started flying in the summer of 2016 and became an instructor in 2022. Ryan is a gold seal instructor with over 1500 hours dual given. He enjoys using his flight privileges to explore new places in the Midwest. Ryan’s favorite thing about instructing is seeing the “light bulb” moment in his student and watching them achieve their aviation dreams.",
          roles: "Advanced Flight Instructor",
          tags: "CFI, CFII, MEI",
          image: {
            src: "/src/assets/team/CFI-Ryan-Tindall_PIC_Flight-School_Pilot-Training_Pilot-Instructional-Center.png",
            alt: "",
          },
        },
      ],
};

const {content = example } = Astro.props;
---


<div class="bg-logo py-24 sm:py-32 text-primary-600">
  <div class="mx-auto max-w-7xl px-6 text-center lg:px-8">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-4xl font-semibold tracking-tight text-balance  sm:text-5xl uppercase" data-aos="fade-right" data-aos-duration="1500">{content.title}</h2>
      <p class="mt-6 text-lg/8 text-accent-600" data-aos="fade-left" data-aos-duration="1500">{content.description}</p>
    </div>
    <ul role="list" class="mx-auto mt-20 grid max-w-2xl grid-cols-1 gap-6 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-2 lg:gap-8 ">
      {
        content.team.map((member:any) => (
            <li class="px-8 py-8 ">
              <ImageComp 
                src={member.image.src}
                alt={member.image.alt}
                classes="object-cover mx-auto size-34 h-34 rounded-full md:size-56 border-4 border-primary-800/80"
              />
            <h3 class="mt-6 text-xl font-semibold tracking-tight uppercase border-t py-2 pt-2 border-primary-800/80 " data-aos="fade-left" data-aos-duration="1500">{member.name}</h3>
            <p class="text-lg text-accent-600 font-semibold" data-aos="fade-right" data-aos-duration="1500">{member.roles}</p>
            <p class="text-sm/6 text-accent-600 " data-aos="fade-left" data-aos-duration="1500">{member.description}</p>
            <p class="text-accent-600 uppercase text-lg  font-bold" data-aos="zoom-in" data-aos-delay="300" data-aos-duration="1500">{member.tags}</p>
            {/* <ul role="list" class="mt-6 flex justify-center gap-x-6 border-b py-2 pb-2 border-primary-800/80 ">
              <li>
                  <a href="#" class="  ">
                  <span class="sr-only">X</span>
                  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                      <path d="M11.4678 8.77491L17.2961 2H15.915L10.8543 7.88256L6.81232 2H2.15039L8.26263 10.8955L2.15039 18H3.53159L8.87581 11.7878L13.1444 18H17.8063L11.4675 8.77491H11.4678ZM9.57608 10.9738L8.95678 10.0881L4.02925 3.03974H6.15068L10.1273 8.72795L10.7466 9.61374L15.9156 17.0075H13.7942L9.57608 10.9742V10.9738Z" />
                  </svg>
                  </a>
              </li>
              <li>
                  <a href="#" class="  ">
                  <span class="sr-only">LinkedIn</span>
