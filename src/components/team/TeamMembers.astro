---
import { getCollection } from "astro:content";
import ImageComp from "../utils/ImageComp.astro";

// 1. Fetch all team members dynamically from the markdown collection
const teamEntries = await getCollection("team");

// Map entries and grab their data + unique ID (slug)
const allMembers = teamEntries.map((entry) => ({
  id: entry.id.replace(/\.[^/.]+$/, ""),
  ...entry.data,
}));

// Filter into Leadership and CFIs
const leadership = allMembers.filter((m) => m.category === "leadership");
const cfiTeam = allMembers.filter((m) => m.category === "cfi");

const {
  content = {
    upperHeading: "Meet our team",
    title: "Our Team",
    description: "Dedicated professionals committed to excellence in aviation training.",
  },
} = Astro.props;
---

<div class="bg-logo py-24 sm:py-32 text-primary-600 font-sans">
  <div class="mx-auto max-w-7xl px-6 text-center lg:px-8">
    
    <div class="mx-auto max-w-2xl mb-16">
      {content.upperHeading && (
        <span class="text-xs font-bold uppercase tracking-widest text-accent-500 block mb-3">
          {content.upperHeading}
        </span>
      )}
      <h2
        class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl uppercase text-primary-800"
        data-aos="fade-right"
        data-aos-duration="1500"
        set:html={content.title}
      />
      <p
        class="mt-6 text-lg/8 text-primary-600 font-light"
        data-aos="fade-left"
        data-aos-duration="1500"
        set:html={content.description}
      />
    </div>

    {/* 1. LEADERSHIP SECTION */}
    {leadership.length > 0 && (
      <div class="mb-24">
        <h3 class="text-2xl font-bold uppercase tracking-widest text-primary-800 mb-10 border-b pb-4 border-primary-800/20 max-w-xl mx-auto">
          Leadership
        </h3>
        
        <ul role="list" class="mx-auto flex flex-wrap justify-center items-stretch gap-8 max-w-5xl">
          {leadership.map((member) => (
            <li class="w-full sm:w-[calc(50%-1rem)] max-w-lg">
              <a
                href={`/about/our-team/${member.id}/`}
                class="group block px-8 py-10 rounded-3xl bg-primary-800 text-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl border border-primary-700 h-full flex flex-col justify-between"
              >
                <div>
                  {(member.imageSrc || member.image?.src) && (
                    <div class="mx-auto size-36 md:size-48 rounded-full overflow-hidden border-4 border-accent-500 shadow-md">
                      <ImageComp
                        src={member.imageSrc || member.image?.src}
                        alt={member.imageAlt || member.image?.alt || member.name}
                        classes="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  )}
                  <h4 class="mt-6 text-2xl font-semibold tracking-tight uppercase border-t py-3 border-white/20 text-white" set:html={member.name} />
                  <p class="text-base text-accent-400 font-bold uppercase tracking-wider">{member.role}</p>
                  <p class="mt-4 text-sm/6 text-white/80 line-clamp-3 font-light">
                    {Array.isArray(member.bio) ? member.bio[0] : (member.bio || member.description)}
                  </p>
                </div>
                {member.credentials && (
                  <div class="mt-6">
                    <span class="inline-block px-4 py-1.5 rounded-full bg-accent-500 text-white text-xs font-bold tracking-widest uppercase shadow-sm">
                      {member.credentials}
                    </span>
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {/* 2. CFI TEAM SECTION */}
    {cfiTeam.length > 0 && (
      <div>
        <h3 class="text-2xl font-bold uppercase tracking-widest text-primary-800 mb-10 border-b pb-4 border-primary-800/20 max-w-xl mx-auto">
          Certified Flight Instructors (CFIs)
        </h3>

        <ul role="list" class="mx-auto flex flex-wrap justify-center items-stretch gap-8 max-w-5xl">
          {cfiTeam.map((member) => (
            <li class="w-full sm:w-[calc(50%-1rem)] max-w-lg">
              <a
                href={`/about/our-team/${member.id}/`}
                class="group block px-8 py-8 rounded-3xl bg-white text-primary-600 shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl border border-primary-800/10 h-full flex flex-col justify-between"
              >
                <div>
                  {(member.imageSrc || member.image?.src) && (
                    <div class="mx-auto size-34 md:size-56 rounded-full overflow-hidden border-4 border-primary-800/80 shadow-md">
                      <ImageComp
                        src={member.imageSrc || member.image?.src}
                        alt={member.imageAlt || member.image?.alt || member.name}
                        classes="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  )}
                  <h4 class="mt-6 text-xl font-semibold tracking-tight uppercase border-t py-2 pt-2 border-primary-800/80 text-primary-800" set:html={member.name} />
                  <p class="text-lg text-accent-600 font-semibold">{member.role}</p>
                  <p class="mt-3 text-sm/6 text-primary-600 line-clamp-3 font-light">
                    {Array.isArray(member.bio) ? member.bio[0] : (member.bio || member.description)}
                  </p>
                </div>
                {member.credentials && (
                  <div class="mt-6">
                    <p class="text-accent-600 uppercase text-lg font-bold tracking-wider">{member.credentials}</p>
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>
</div>