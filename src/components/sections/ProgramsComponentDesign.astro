---
import { website_links } from "../../data/consts";
import ImageComp from "../utils/ImageComp.astro";

const { program } = Astro.props;
---

<section class="relative bg-[#fcfaf8] py-12 lg:py-24 overflow-hidden font-sans">
  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="lg:order-1">
        <div class="max-w-xl">
          <span
            class="text-xs font-black uppercase tracking-[0.4em] text-[#4b7992] whitespace-nowrap mb-4 block"
          >
            {program.overview.upperHeader}
          </span>
          <h2
            class="text-4xl font-extrabold tracking-tight text-[#423731] sm:text-5xl uppercase leading-[1.1]"
          >
            {program.overview.title}
          </h2>
          <div class="mt-6 h-1.5 w-20 bg-[#4b7992] rounded-full"></div>

          <div class="mt-8 space-y-6 text-lg leading-8 text-[#5d4d40]/80">
            <p>{program.overview.description}</p>
          </div>

          <div
            class="mt-10 p-6 bg-white border-l-4 border-[#4b7992] rounded-r-2xl shadow-sm"
          >
            <h4
              class="text-[#423731] font-bold uppercase tracking-widest text-sm mb-4 flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 text-[#4b7992]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path></svg
              >
              {program.overview.targetAudience.title}
            </h4>
            <ul class="space-y-2">
              {
                program.overview.targetAudience.points.map((point: any) => (
                  <li class="flex items-start gap-2 text-[#5d4d40]/80 text-sm font-medium">
                    <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-[#dcc1a6]" />
                    {point}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="mt-10 flex gap-6 border-t border-[#dcc1a6]/30 pt-8">
            {
              program.overview.summary.map((stat: any) => (
                <div>
                  <p class="text-xs uppercase tracking-[0.2em] text-[#4b7992] font-bold mb-1">
                    {stat.title}
                  </p>
                  <p class="text-2xl font-black text-[#423731] tracking-tighter italic">
                    {stat.value}
                  </p>
                </div>
              ))
            }
          </div>

          <div class="mt-16 text-left">
            <a
              href={`#${website_links.enroll.id}`}
              class="group relative inline-flex items-center justify-center px-10 py-5 bg-[#423731] text-white font-bold rounded-full overflow-hidden transition-all hover:bg-[#4b7992] shadow-xl"
            >
              <span class="z-10 uppercase tracking-[0.2em] text-sm"
                >Start Your Training Today</span
              >
              <div
                class="absolute bottom-0 left-0 h-1 bg-[#dcc1a6] w-0 transition-all duration-500 group-hover:w-full"
              >
              </div>
            </a>
          </div>
        </div>
      </div>

      <div class="relative group lg:order-2">
        <div
          class="relative aspect-square sm:aspect-video lg:aspect-4/5 overflow-hidden rounded-3xl shadow-2xl"
        >
          <svg
            class="absolute inset-0 w-full h-full z-30 pointer-events-none"
            fill="none"
          >
            <rect
              x="2"
              y="2"
              rx="22"
              width="calc(100% - 4px)"
              height="calc(100% - 4px)"
              class="stroke-[#4b7992] stroke-[6px] opacity-0 transition-all duration-700 group-hover:opacity-100"
              style="stroke-dasharray: 3000; stroke-dashoffset: 3000;"></rect>
          </svg>

          <ImageComp
            src={program.overview.image.src}
            alt={program.overview.image.alt}
            classes="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-[#423731]/40 via-transparent to-transparent"
          >
          </div>
        </div>

        <div
          class="absolute -bottom-6 -right-6 -z-10 w-32 h-32 bg-[#dcc1a6]/20 rounded-full blur-2xl"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<section
  class="bg-[#4b7992] text-white py-12 lg:py-24 font-sans overflow-hidden"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2
        class="text-3xl font-extrabold tracking-tight sm:text-5xl uppercase leading-tight"
      >
        Program Structure
      </h2>
      <div class="mt-6 h-1.5 w-24 bg-[#dcc1a6] mx-auto rounded-full"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-stretch">
      <div
        class="group relative bg-white p-8 md:p-12 rounded-3xl shadow-xl shadow-neutral-200/50 border border-neutral-100 transition-all duration-500 hover:-translate-y-2"
      >
        <div class="flex items-center gap-4 mb-8">
          <div
            class="flex-none w-12 h-12 rounded-xl bg-[#4b7992]/10 flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-[#4b7992]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#423731] uppercase tracking-tight">
            Prerequisites
          </h3>
        </div>

        <ul class="space-y-5">
          {
            program.overview.requirements.map((item: any) => (
              <li class="flex items-start gap-4 text-[#5d4d40] group/item">
                <span class="mt-1.5 h-2 w-2 rounded-full bg-[#4b7992] transition-all group-hover/item:scale-150" />
                <span class="text-lg leading-snug">{item}</span>
              </li>
            ))
          }
        </ul>
        <div
          class="mt-10 h-1 w-12 bg-[#4b7992] transition-all duration-500 group-hover:w-full rounded-full"
        >
        </div>
      </div>

      <div
        class="group relative bg-white/5 p-8 md:p-12 rounded-3xl border border-dashed border-white/20 transition-all duration-500 hover:bg-white hover:shadow-xl hover:border-solid hover:-translate-y-2"
      >
        <div class="flex items-center gap-4 mb-8">
          <div
            class="flex-none w-12 h-12 rounded-xl bg-[#dcc1a6]/20 flex items-center justify-center group-hover:bg-[#4b7992]/10 transition-colors"
          >
            <svg
              class="w-6 h-6 text-[#dcc1a6] group-hover:text-[#4b7992]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
              ></path>
            </svg>
          </div>
          <h3
            class="text-xl font-bold text-white group-hover:text-[#423731] uppercase tracking-tight transition-colors"
          >
            What's Included
          </h3>
        </div>

        <ul
          class="space-y-5 text-white group-hover:text-[#423731]/80 transition-colors"
        >
          {
            program.overview.included.map((item: any) => (
              <li class="flex items-start gap-4">
                <span class="mt-2.5 h-px w-3 bg-[#dcc1a6] group-hover:bg-[#4b7992]/30 transition-colors" />
                <span class="text-lg leading-snug italic">{item}</span>
              </li>
            ))
          }
        </ul>
        <div
          class="mt-10 h-1 w-12 bg-[#dcc1a6] transition-all duration-500 group-hover:w-24 rounded-full group-hover:bg-[#4b7992]/20"
        >
        </div>
      </div>
    </div>

    <div class="mt-16 text-center">
      <a
        href={`#${website_links.enroll.id}`}
        class="group relative inline-flex items-center justify-center px-10 py-5 bg-[#423731] text-stone-200 font-bold rounded-full overflow-hidden transition-all hover:bg-stone-200 hover:text-primary-800 shadow-xl"
      >
        <span class="z-10 uppercase tracking-widest text-sm">Enroll Today</span>
        <div
          class="absolute bottom-0 left-0 h-1 bg-primary-800 w-0 transition-all duration-500 group-hover:w-full"
        >
        </div>
      </a>
    </div>
  </div>
</section>

<section class="bg-[#fcfaf8] py-12 lg:py-24 font-sans overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <span
        class="text-xs font-black uppercase tracking-[0.4em] text-[#4b7992] whitespace-nowrap mb-4 block"
      >
        {program.advantages.upperHeader}
      </span>
      <h2
        class="text-4xl font-bold tracking-tight text-[#423731] sm:text-5xl uppercase leading-[1.1]"
      >
        {program.advantages.title}
      </h2>
      <div class="mt-6 h-1.5 w-24 bg-[#4b7992] rounded-full"></div>
      <p class="mt-8 text-lg leading-8 text-[#5d4d40]/80">
        {program.advantages.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        program.advantages.bullets.map((bullet: any, index: number) => (
          <div class="group flex flex-col bg-white rounded-3xl p-8 shadow-sm border border-neutral-100 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2">
            <div class="mb-8 flex items-center justify-between">
              <div class="w-14 h-14 rounded-2xl bg-[#4b7992] text-white flex items-center justify-center text-xl font-black shadow-lg shadow-[#4b7992]/20 group-hover:scale-110 group-hover:rotate-6 transition-all duration-500">
                0{index + 1}
              </div>
              <div class="h-px flex-grow ml-4 bg-[#dcc1a6]/30 group-hover:bg-[#4b7992]/30 transition-colors" />
            </div>

            <h3 class="text-xl font-bold text-[#423731] uppercase tracking-tight mb-4">
              {bullet.title}
            </h3>
            <p class="text-[#5d4d40]/70 leading-relaxed flex-grow">
              {bullet.description}
            </p>
            <div class="mt-6 h-1 w-12 bg-[#4b7992] transition-all duration-500 group-hover:w-full rounded-full" />
          </div>
        ))
      }
    </div>
    <div class="mt-16 text-center">
      <a
        href={`#${website_links.enroll.id}`}
        class="group relative inline-flex items-center justify-center px-10 py-5 bg-[#423731] text-white font-bold rounded-full overflow-hidden transition-all hover:bg-[#4b7992] shadow-xl"
      >
        <span class="z-10 uppercase tracking-[0.2em] text-sm">Join Us</span>
        <div
          class="absolute bottom-0 left-0 h-1 bg-[#dcc1a6] w-0 transition-all duration-500 group-hover:w-full"
        >
        </div>
      </a>
    </div>
  </div>
</section>

<section class="bg-white py-12 lg:py-24 font-sans border-t border-neutral-100">
  <div class="mx-auto max-w-5xl px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2
        class="text-3xl font-extrabold tracking-tight text-[#423731] sm:text-4xl uppercase"
      >
        {program.price.title}
      </h2>
      <p class="mt-4 text-[#5d4d40]/70 italic max-w-2xl mx-auto">
        {program.price.description}
      </p>
    </div>

    <div
      class="bg-[#fcfaf8] rounded-3xl p-1 py-4 lg:p-8 shadow-sm border border-neutral-100 group transition-all duration-500 hover:shadow-xl"
    >
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr
              class="text-[#4b7992] text-xs uppercase tracking-widest border-b-2 border-[#dcc1a6]/30"
            >
              <th class="pb-4 px-4 font-bold">Training Item</th>
              <th class="pb-4 px-4 font-bold">Hours</th>
              <th class="pb-4 px-4 font-bold hidden lg:block">Rate</th>
              <th class="pb-4 px-4 font-bold text-right">Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#dcc1a6]/20">
            {
              program.price.breakdown.map((item: any) => (
                <tr class="transition-colors hover:bg-white">
                  <td class="py-4 px-4 font-bold text-[#423731]">
                    {item.title}
                  </td>
                  <td class="py-4 px-4 text-[#5d4d40]/80">
                    {item.duration || "--"}
                  </td>
                  <td class="py-4 px-4 text-[#5d4d40]/80 hidden lg:block">
                    {item.rate || "--"}
                  </td>
                  <td class="py-4 px-4 text-right font-bold text-[#423731]">
                    ${item.value}
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr class="border-t-2 border-[#4b7992] hidden lg:table-row">
              <td
                colspan="3"
                class="py-6 px-4 font-black uppercase text-[#423731] text-xl"
                >Total Estimated Price</td
              >
              <td
                class="py-6 px-4 text-right font-black text-2xl text-[#4b7992] italic"
                >${program.price.priceTotal}</td
              >
            </tr>            
            <tr class="border-t-2 border-[#4b7992] lg:hidden">
              <td
                colspan="2"
                class="py-6 px-4 font-black uppercase text-[#423731] text-xl"
                >Total</td
              >
              <td
                class="py-6 px-4 text-right font-black text-2xl text-[#4b7992] italic"
                >${program.price.priceTotal}</td
              >
            </tr>
            
          </tfoot>
        </table>
      </div>
    </div>

    <div class="mt-16 text-center">
      <a
        href={`#${website_links.enroll.id}`}
        class="group relative inline-flex items-center justify-center px-10 py-5 bg-[#423731] text-white font-bold rounded-full overflow-hidden transition-all hover:bg-[#4b7992] shadow-xl"
      >
        <span class="relative z-10 uppercase tracking-[0.2em] text-sm"
          >Start Your Training Today</span
        >
        <div
          class="absolute bottom-0 left-0 h-1 bg-[#dcc1a6] w-0 transition-all duration-500 group-hover:w-full"
        >
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .group:hover rect {
    animation: drawBorder 1.5s ease-in-out forwards;
  }

  @keyframes drawBorder {
    from {
      stroke-dashoffset: 3000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
