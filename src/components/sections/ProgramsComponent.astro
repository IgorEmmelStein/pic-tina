  advantages: {
    upperHeader: "EXAMPLE UPPER HEADER",
    title: "Example Title for Content Right Component",
    description:
      "This is an example description for the Content Right component. It provides information about the content displayed on the right side of the layout.",
    bullets: [
      {
        icon: "M3 18h18v2H3zm18.509-9.473a1.61 1.61 0 0 0-2.036-1.019L15 9L7 6L5 7l6 4l-4 2l-4-2l-1 1l4 4l14.547-5.455a1.61 1.61 0 0 0 .962-2.018",
        title: "Career Growth & Opportunity",
        description:
          "Commercial aviation, charter operations, and corporate flying all need skilled pilots. Training now positions you for a career that’s in high demand and globally respected.",
      },
      {
        icon: "M12 2a1 1 0 0 1 .932.638l7 18a1 1 0 0 1-1.326 1.281L13 19.517V13a1 1 0 1 0-2 0v6.517l-5.606 2.402a1 1 0 0 1-1.326-1.281l7-18A1 1 0 0 1 12 2",
        title: "Freedom & Adventure",
        description:
          "Enjoy the unmatched perspective of seeing the world from above. Flying offers a lifestyle of independence, excitement, and exploration few other careers can match.",
      },
      {
        icon: "",
        title: "Challenge & Achievement",
        description:
          "Learning to fly is one of life’s most rewarding accomplishments, an achievement that builds confidence, discipline, and problem-solving skills that last a lifetime.",
      },
    ],
  },
  price: {
    image: {
      src: "/src/assets/aircrew-member-using-control-panel-command-dashboard-navigation-fly-ariplane-cockpit-female-airliner-flying-plane-cabin-with-power-engine-switch-lever-close-up.jpg",
      alt: "Aircrew member using control panel in airplane cockpit",
    },
    upperHeader: "EXAMPLE UPPER HEADER",
    title: "Example Title for Content Right Component",
    description:
      "This is an example description for the Content Right component. It provides information about the content displayed on the right side of the layout.",
    descriptions: [
      "First example description point.",
      "Second example description point.",
      "Third example description point.",
    ],
    bullets: [
      {
        icon: "M3 18h18v2H3zm18.509-9.473a1.61 1.61 0 0 0-2.036-1.019L15 9L7 6L5 7l6 4l-4 2l-4-2l-1 1l4 4l14.547-5.455a1.61 1.61 0 0 0 .962-2.018",
        title: "Career Growth & Opportunity",
        description:
          "Commercial aviation, charter operations, and corporate flying all need skilled pilots. Training now positions you for a career that’s in high demand and globally respected.",
      },
      {
        icon: "M12 2a1 1 0 0 1 .932.638l7 18a1 1 0 0 1-1.326 1.281L13 19.517V13a1 1 0 1 0-2 0v6.517l-5.606 2.402a1 1 0 0 1-1.326-1.281l7-18A1 1 0 0 1 12 2",
        title: "Freedom & Adventure",
        description:
          "Enjoy the unmatched perspective of seeing the world from above. Flying offers a lifestyle of independence, excitement, and exploration few other careers can match.",
      },
      {
        icon: "",
