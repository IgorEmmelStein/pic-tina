---
import ImageComp from "../utils/ImageComp.astro";

interface Bullet {
  icon?: string;
  title?: string;
  description?: string;
}

interface ButtonItem {
  text?: string;
  href?: string;
  style?: string;
}

interface Props {
  content?: {
    image?: {
      src?: string;
      alt?: string;
    };
    upperHeader?: string;
    upperHeading?: string;
    title?: string;
    description?: string;
    descriptions?: string[];
    bullets?: Bullet[];
    button?: ButtonItem;
    buttons?: ButtonItem[];
  };
}

const example = {
  image: {
    src: "/src/assets/stock-man-airplanes-museum.jpg",
    alt: "Student pilots preparing for flight at Pilot Instructional Center",
  },
  upperHeader: "WHY BECOME A PILOT",
  title: "Turn Your Passion for Flight into a Career",
  description:
    "Becoming a pilot isn’t just about flying, it’s about freedom, mastery, and opportunity. From private flying adventures to professional aviation careers, the sky is truly the limit. At Pilot Instructional Center, we’ll help you take your first steps confidently with expert guidance and real-world instruction.",
  descriptions: [
    "Experience the thrill of flight and personal growth.",
    "Gain in-demand skills that open doors worldwide.",
    "Join a community of professionals who love what they do.",
  ],
  bullets: [
    {
      icon: "M3 18h18v2H3zm18.509-9.473a1.61 1.61 0 0 0-2.036-1.019L15 9L7 6L5 7l6 4l-4 2l-4-2l-1 1l4 4l14.547-5.455a1.61 1.61 0 0 0 .962-2.018",
      title: "Career Growth & Opportunity",
      description:
        "Commercial aviation, charter operations, and corporate flying all need skilled pilots. Training now positions you for a career that’s in high demand and globally respected.",
    },
    {
      icon: "M12 2a1 1 0 0 1 .932.638l7 18a1 1 0 0 1-1.326 1.281L13 19.517V13a1 1 0 1 0-2 0v6.517l-5.606 2.402a1 1 0 0 1-1.326-1.281l7-18A1 1 0 0 1 12 2",
      title: "Freedom & Adventure",
      description:
        "Enjoy the unmatched perspective of seeing the world from above. Flying offers a lifestyle of independence, excitement, and exploration few other careers can match.",
    },
    {
      icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
      title: "Challenge & Achievement",
      description:
        "Learning to fly is one of life’s most rewarding accomplishments, an achievement that builds confidence, discipline, and problem-solving skills that last a lifetime.",
    },
  ],
  button: {
    text: "Start Your Pilot Journey",
    href: "/contact/",
  },
};

const { content: rawContent } = Astro.props;

// Safe merge: Guarantees bullets and buttons never throw undefined errors
const content = {
  ...example,
  ...rawContent,
  upperHeader: rawContent?.upperHeader || rawContent?.upperHeading || example.upperHeader,
  bullets: rawContent?.bullets?.length ? rawContent.bullets : example.bullets,
  button: rawContent?.button || rawContent?.buttons?.[0] || example.button,
};

const bullets = content.bullets || [];
const button = content.button;
---

<section class="relative overflow-hidden bg-logo py-16 sm:py-24 font-sans">
  <div
    class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-96 h-96 rounded-full border-[1px] border-accent-500 opacity-30 pointer-events-none"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col items-center text-center">
      {content.upperHeader && (
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-800 text-white text-xs font-bold tracking-widest uppercase mb-6"
          data-aos="fade-down"
          data-aos-duration="1000"
          set:html={content.upperHeader}
        />
      )}

      {content.title && (
        <h2
          class="text-4xl font-bold tracking-tight text-primary-800 sm:text-5xl max-w-3xl"
          data-aos="fade-up"
          data-aos-duration="1000"
          data-aos-delay="200"
          set:html={content.title}
        />
      )}

      {content.description && (
        <p
          class="mt-6 text-lg leading-8 text-primary-600 max-w-2xl font-light"
          data-aos="fade-up"
          data-aos-duration="1000"
          data-aos-delay="400"
          set:html={content.description}
        />
      )}

      {bullets.length > 0 && (
        <ul
          class="mt-16 grid grid-cols-1 gap-y-12 sm:grid-cols-3 sm:gap-x-8 lg:gap-x-12 w-full max-w-5xl"
        >
          {bullets.map((bullet, index) => (
            <li
              class="group flex flex-col items-center"
              data-aos="fade-up"
              data-aos-duration="1000"
              data-aos-delay={600 + index * 150}
            >
              <div class="relative mb-6">
                <div class="absolute inset-0 rounded-full border-2 border-dashed border-accent-300 scale-125 opacity-0 group-hover:opacity-100 group-hover:rotate-180 transition-all duration-1000" />

                <div class="relative flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-md text-accent-500 group-hover:bg-accent-500 group-hover:text-white transition-colors duration-300">
                  <svg
                    class="w-8 h-8"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d={bullet.icon || "M5 13l4 4L19 7"}
                    />
                  </svg>
                </div>
              </div>

              {bullet.title && (
                <h3 class="text-xl font-bold text-primary-800 mb-3" set:html={bullet.title} />
              )}
              {bullet.description && (
                <p
                  class="text-sm text-primary-600 leading-relaxed text-pretty text-center px-4"
                  set:html={bullet.description}
                />
              )}
            </li>
          ))}
        </ul>
      )}

      {button?.href && button?.text && (
        <div
          class="mt-16"
          data-aos="zoom-in"
          data-aos-duration="1000"
          data-aos-delay="1200"
        >
          <a
            href={button.href}
            class="inline-flex btn-accent items-center justify-center rounded-full bg-accent-500 px-10 py-4 text-sm font-bold text-white shadow-xl shadow-accent-500/20 hover:bg-accent-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 transition-all transform hover:-translate-y-1 active:scale-95"
          >
            <span>{button.text}</span>
            <svg
              class="ml-2 w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .group.js-hover .group-hover\:opacity-100 {
    opacity: 1 !important;
  }
  .group.js-hover .group-hover\:rotate-180 {
    transform: rotate(180deg) !important;
  }
  .group.js-hover .group-hover\:bg-accent-500 {
    background-color: var(--color-accent-500) !important;
  }
  .group.js-hover .group-hover\:text-white {
    color: white !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const options = {
      root: null,
      threshold: 0.5,
    };

    const observer = new IntersectionObserver((entries, observerInstance) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const card = entry.target;
          card.classList.add("js-hover");
          setTimeout(() => {
            card.classList.remove("js-hover");
          }, 2000);
          observerInstance.unobserve(card);
        }
      });
    }, options);

    document.querySelectorAll(".group").forEach((card) => {
      observer.observe(card);
    });
  });
</script>