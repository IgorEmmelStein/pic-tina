---
const { categories } = Astro.props;

// Flatten all questions for the search engine to use
const allQuestions = categories.flatMap((cat) =>
  cat.data.questions.map((q) => ({ ...q, categoryId: cat.id })),
);
---

<section class="bg-[#423731] py-24 px-6" id="faq-section">
  <div class="mx-auto max-w-7xl">
    <div class="text-center mb-16">
      <h2
        class="text-4xl md:text-6xl font-black text-white mb-8 tracking-tight"
      >
        How can we help?
      </h2>

      <div class="relative max-w-2xl mx-auto mb-10">
        <div
          class="absolute inset-y-0 left-5 flex items-center pointer-events-none"
        >
          <svg
            class="w-5 h-5 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="faq-search"
          placeholder="Search by keyword (e.g. 'Medical', 'Cost', 'Solo')..."
          class="w-full bg-white/10 border border-white/20 rounded-2xl py-5 pl-14 pr-6 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#dcc1a6] transition-all"
        />
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        <button
          class="faq-filter active px-6 py-2 rounded-full border border-white/20 text-white text-sm font-bold uppercase tracking-widest transition-all hover:bg-white/10"
          data-category="all"
        >
          All Questions
        </button>
        {
          categories.map((cat) => (
            <button
              class="faq-filter px-6 py-2 rounded-full border border-white/20 text-white text-sm font-bold uppercase tracking-widest transition-all hover:bg-white/10"
              data-category={cat.id}
            >
              {cat.name}
            </button>
          ))
        }
      </div>
    </div>

    <div class="max-w-4xl mx-auto">
      <dl class="space-y-4" id="faq-list">
        {
          allQuestions.map((item, index) => (
            <div
              class="faq-item border border-white/10 rounded-2xl overflow-hidden bg-white/5 transition-all duration-300"
              data-category={item.categoryId}
              data-question={item.question.toLowerCase()}
            >
              <details class="group p-6">
                <summary class="flex justify-between items-center cursor-pointer list-none">
                  <span class="text-lg font-bold text-white pr-8 leading-tight">
                    {item.question}
                  </span>
                  <span class="text-white text-2xl transition-transform duration-300 group-open:rotate-90">
                    ⟩
                  </span>
                </summary>
                <div class="mt-4 text-white/80 leading-relaxed text-base border-t border-white/10 pt-4">
                  {item.answer}
                </div>
              </details>
            </div>
          ))
        }
      </dl>

      <div id="faq-empty" class="hidden text-center py-20">
        <p class="text-white/60 italic text-lg">
          No questions found matching your search.
        </p>
      </div>
    </div>

    <div
      class="mt-20 text-center bg-white/5 p-12 rounded-[3rem] border border-white/10 max-w-4xl mx-auto"
    >
      <h3 class="text-2xl font-bold text-white mb-4">
        Still have a specific question?
      </h3>
      <p class="text-white/70 mb-8 max-w-md mx-auto text-sm">
        Our senior instructors are happy to discuss your specific goals and
        flight training timeline.
      </p>
      <a
        href="/contact/"
        class="inline-block bg-[#dcc1a6] text-[#423731] px-10 py-4 rounded-xl font-black uppercase tracking-widest text-xs hover:bg-white transition-all transform hover:-translate-y-1"
      >
        Contact PIC Now
      </a>
    </div>
  </div>
</section>

<style>
  /* Custom Focus state for buttons */
  .faq-filter.active {
    background-color: #dcc1a6;
    color: #423731;
    border-color: #dcc1a6;
  }

  /* Remove default arrows */
  summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  function initFAQ() {
    const searchInput = document.getElementById(
      "faq-search",
    ) as HTMLInputElement;
    const filterButtons = document.querySelectorAll(".faq-filter");
    const faqItems = document.querySelectorAll(".faq-item");
    const emptyState = document.getElementById("faq-empty");

    let activeCategory = "all";
    let searchTerm = "";

    function filter() {
      let visibleCount = 0;

      faqItems.forEach((item: any) => {
        const matchesCategory =
          activeCategory === "all" || item.dataset.category === activeCategory;
        const matchesSearch = item.dataset.question.includes(searchTerm);

        if (matchesCategory && matchesSearch) {
          item.classList.remove("hidden");
          visibleCount++;
        } else {
          item.classList.add("hidden");
        }
      });

      if (visibleCount === 0) emptyState?.classList.remove("hidden");
      else emptyState?.classList.add("hidden");
    }

    // Search logic
    searchInput?.addEventListener("input", (e: any) => {
      searchTerm = e.target.value.toLowerCase();
      filter();
    });

    // Category logic
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeCategory = (btn as HTMLElement).dataset.category || "all";
        filter();
      });
    });
  }

  // Run on load
  initFAQ();
  // For View Transitions (if you use them)
  document.addEventListener("astro:after-swap", initFAQ);
</script>
