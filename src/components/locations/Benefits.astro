---
import ImageComp from "../utils/ImageComp.astro";

// Benefits of Training with PIC
const { content } = Astro.props;

// Icon Mapping helper
const getIcon = (iconName: string) => {
  const icons: Record<string, any> = {
    user: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
    clock: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    plane:
      "M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9",
    "graduation-cap":
      "M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z",
  };
  return icons[iconName] || icons.user;
};
---

<section class="bg-[#fcfaf8] py-24 px-6 relative overflow-hidden">
  <div
    class="absolute top-0 right-0 w-1/3 h-full bg-[#dcc1a6]/5 -skew-x-12 transform translate-x-1/2"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="max-w-3xl mb-20" data-aos="fade-up">
      <span
        class="text-[#745e4d] font-black uppercase tracking-[0.4em] text-xs mb-4 block"
      >
        {content.upperHeading}
      </span>
      <h2 class="text-5xl font-black text-[#423731] leading-tight mb-6">
        {content.title}
      </h2>
      <p class="text-xl text-[#745e4d] leading-relaxed mb-6">
        {content.description}
      </p>
      {
        content.descriptions.map((text: string) => (
          <p class="text-[#5d4d40] text-sm opacity-75">{text}</p>
        ))
      }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      <div class="lg:col-span-5 order-2 lg:order-1" data-aos="fade-right">
        <div class="relative">
          <div
            class="aspect-[3/4] rounded-[2rem] overflow-hidden shadow-2xl relative z-10"
          >
            <div class="absolute inset-0 bg-[#423731]/10 mix-blend-multiply">
            </div>
            <div
              class="w-full h-full bg-[#dcc1a6]/30 flex items-center justify-center text-center text-[#423731] italic font-medium border-4 border-white"
            >
              <ImageComp
                src={content.image.src ||
                  "/src/assets/cody-f-OdHh60XP7EI-unsplash.jpg"}
                alt={content.image.alt}
                class="object-cover w-full h-full"
              />
            </div>
          </div>
          <div
            class="absolute -top-6 -left-6 w-24 h-24 bg-[#dcc1a6] rounded-full -z-10 animate-pulse"
          >
          </div>
          <div
            class="absolute -bottom-10 -right-10 w-full h-full border-2 border-[#745e4d]/20 rounded-[2rem] -z-10"
          >
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 order-1 lg:order-2 space-y-12">
        {
          content.benefits.map((benefit: any, index: number) => (
            <div
              class="bg-white p-10 rounded-[2.5rem] shadow-sm border border-[#dcc1a6]/20 transition-all hover:shadow-xl group"
              data-aos="fade-left"
              data-aos-delay={index * 150}
            >
              <h3 class="text-2xl font-bold text-[#423731] mb-4 group-hover:text-[#745e4d] transition-colors">
                {benefit.title}
              </h3>
              <p class="text-[#745e4d] text-sm mb-8 leading-relaxed border-l-2 border-[#dcc1a6] pl-4">
                {benefit.description}
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {benefit.bullets.map((bullet: any) => (
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-[#dcc1a6]/20 flex items-center justify-center shrink-0 group-hover:bg-[#dcc1a6] transition-colors">
                      <svg
                        class="w-5 h-5 text-[#423731]"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.5"
                          d={getIcon(bullet.icon)}
                        />
                      </svg>
                    </div>
                    <div>
                      <h4 class="text-sm font-black text-[#423731] uppercase tracking-tight">
                        {bullet.title}
                      </h4>
                      <p class="text-xs text-[#745e4d] mt-1 leading-snug">
                        {bullet.description}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
