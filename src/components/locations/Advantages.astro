---
import ImageComp from "../utils/ImageComp.astro";

const { content } = Astro.props;
---

<section class="bg-[#faf9f8] py-24 px-6 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center mb-32">
      <div data-aos="fade-right">
        <div class="inline-flex items-center gap-3 mb-6">
          <span class="h-[1px] w-8 bg-[#dcc1a6]"></span>
          <span
            class="text-[#745e4d] font-bold uppercase tracking-[0.3em] text-[10px]"
          >
            {content.upperHeading}
          </span>
        </div>

        <h2
          class="text-4xl md:text-6xl font-bold text-[#423731] leading-[1.1] mb-8 tracking-tight"
        >
          {content.title}
        </h2>

        <p class="text-lg text-[#745e4d] mb-10 leading-relaxed max-w-xl">
          {content.description}
        </p>

        <div class="border-l-2 border-[#dcc1a6] pl-6 mb-10 space-y-4">
          {
            content.descriptions.map((desc: string) => (
              <p class="text-[#5d4d40] text-sm leading-relaxed italic opacity-90">
                "{desc}"
              </p>
            ))
          }
        </div>

        <div class="flex flex-wrap gap-4 mt-12">
          {
            content.buttons.map((btn: any) => (
              <a
                href={btn.href}
                class={`px-10 py-4 rounded-full font-bold uppercase tracking-widest text-[10px] transition-all duration-300 shadow-sm hover:shadow-xl hover:-translate-y-1 ${
                  btn.style === "secondary"
                    ? "bg-white text-[#423731] border border-[#dcc1a6] hover:bg-[#dcc1a6]"
                    : "bg-[#423731] text-white hover:bg-[#5d4d40]"
                }`}
              >
                {btn.text}
              </a>
            ))
          }
        </div>
      </div>

      <div class="relative" data-aos="fade-left">
        <div
          class="relative z-10 rounded-[2.5rem] overflow-hidden shadow-2xl bg-white p-4"
        >
          <div
            class="aspect-[4/5] rounded-[2rem] overflow-hidden bg-[#f3f0ee] relative group"
          >
            <div
              class="absolute inset-0 bg-[#423731]/5 group-hover:bg-transparent transition-colors duration-500"
            >
            </div>
            <div
              class="flex items-center justify-center h-full text-[#745e4d] font-medium italic"
            >
              <ImageComp
                src={content.image.src ||
                  "/src/assets/cody-f-OdHh60XP7EI-unsplash.jpg"}
                alt={content.image.alt}
                class="object-cover w-full h-full aspect-[9/16]"
              />
            </div>
          </div>
        </div>

        <div
          class="absolute -top-10 -right-10 w-40 h-40 bg-[#dcc1a6]/20 rounded-full blur-3xl -z-10"
        >
        </div>

        <div
          class="absolute -bottom-8 -left-8 bg-white p-1 shadow-2xl rounded-3xl z-20"
        >
          <div
            class="bg-[#423731] text-white py-6 px-10 rounded-[1.4rem] flex flex-col items-center border-4 border-[#faf9f8]"
          >
            <span class="text-4xl font-black tracking-tighter mb-1">FAA</span>
            <span
              class="text-[9px] uppercase tracking-[0.2em] font-bold text-[#dcc1a6]"
            >
              Certified Technology
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        content.advantages.map((adv: any, index: number) => (
          <div
            class="bg-white p-12 rounded-[3rem] shadow-sm hover:shadow-xl transition-all duration-500 group border border-transparent hover:border-[#dcc1a6]/30"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="flex items-start justify-between mb-8">
              <h3 class="text-3xl font-bold text-[#423731]">{adv.title}</h3>
              <div class="w-12 h-12 rounded-full bg-[#fcfaf8] flex items-center justify-center group-hover:bg-[#423731] transition-colors duration-300">
                <span class="text-[#dcc1a6] font-bold">0{index + 1}</span>
              </div>
            </div>

            <p class="text-[#745e4d] mb-10 text-base leading-relaxed opacity-90">
              {adv.description}
            </p>

            <div class="grid grid-cols-1 gap-6">
              {adv.bullets.map((subBullet: any) => (
                <div class="flex gap-5 items-start p-4 rounded-2xl transition-colors hover:bg-[#fcfaf8]">
                  <div class="mt-1 w-6 h-6 rounded-lg bg-[#dcc1a6]/30 flex items-center justify-center shrink-0">
                    <svg
                      class="w-3.5 h-3.5 text-[#423731]"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="3"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-[#423731] mb-1">
                      {subBullet.title}
                    </h4>
                    <p class="text-xs text-[#745e4d] leading-normal">
                      {subBullet.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
