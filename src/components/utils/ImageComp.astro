---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  classes?: string;
  quality?: number;
  loading?: "lazy" | "eager";
  widths?: number[];
  sizes?: string;
  priorityFetch?: "high" | "low" | "auto";
  [key: string]: any;
}

const {
  src,
  alt = "",
  classes = "",
  quality = 70,
  loading = "lazy",
  widths: userWidths,
  sizes: userSizes,
  priorityFetch = "low",
  ...rest
} = Astro.props;

// 1. Normalize string path if it's missing leading slash for local assets
let normalizedSrc = src;
if (typeof src === "string" && src.startsWith("src/assets/")) {
  normalizedSrc = "/" + src;
}

// 2. Check if the image is public (/uploads/...), external (http...), or blob
const isPublicOrExternal =
  typeof normalizedSrc === "string" &&
  (normalizedSrc.startsWith("/uploads/") ||
   normalizedSrc.startsWith("/public/") ||
   normalizedSrc.startsWith("http://") ||
   normalizedSrc.startsWith("https://") ||
   normalizedSrc.startsWith("//") ||
   !normalizedSrc.startsWith("/src/assets/"));

// 3. Glob all local images in src/assets
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif,JPEG,JPG,PNG,GIF,WEBP,AVIF}",
);

const isLocalAsset = typeof normalizedSrc === "string" && normalizedSrc.startsWith("/src/assets/");
const imageLoader = isLocalAsset ? images[normalizedSrc as string] : null;

// Dynamically fetch width for responsive image sizes if it's a local asset
let defaultWidth = 1080;
if (imageLoader) {
  try {
    const resolvedImage = await imageLoader();
    defaultWidth = resolvedImage.default.width;
  } catch (e) {
    // Fallback if load fails
  }
}

const widths = userWidths ?? [360, 540, 720, 1080, defaultWidth];
const sizes =
  userSizes ??
  `(max-width: 480px) 360px, (max-width: 720px) 540px, (max-width: 1200px) 720px, (max-width: 1600px) 1080px, ${defaultWidth}px`;
---

{
  isPublicOrExternal ? (
    <img
      src={normalizedSrc as string}
      alt={alt}
      class={classes}
      loading={loading}
      fetchpriority={priorityFetch}
      {...rest}
    />
  ) : imageLoader ? (
    <Image
      src={imageLoader()}
      alt={alt}
      class={classes}
      quality={quality}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={priorityFetch}
      {...rest}
    />
  ) : typeof normalizedSrc !== "string" ? (
    <Image
      src={normalizedSrc}
      alt={alt}
      class={classes}
      quality={quality}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={priorityFetch}
      {...rest}
    />
  ) : (
    <img
      src={normalizedSrc}
      alt={alt}
      class={classes}
      loading={loading}
      fetchpriority={priorityFetch}
      {...rest}
    />
  )
}