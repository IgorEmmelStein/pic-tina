---
import ImageComp from "../utils/ImageComp.astro";
const example = {
  image: {
    src: "/src/assets/fleet/Fleet-Plane-N13659-Cessna_PIC_Flight-School_Pilot-training.jpg",
    alt: "Pilot standing near airplane by Maria Teneva",
  },
  upperHeader: "Featured Aircraft",
  title: "Cessna 172M (N13659)",
  description:
    "This 1974 Cessna 172M, FAA-registered as N13659, is a reliable and well-known training aircraft operated by Pilot Instructional Center LLC. Renowned for its stability, efficiency, and forgiving flight characteristics, the C172M remains one of the most trusted aircraft in flight training worldwide.",
  descriptions: [
    "Manufactured in 1974, this Cessna 172M carries Serial Number 17262919 and is powered by a LYCOMING O-320 series 4-cycle engine rated at 180 horsepower. It falls under the Standard/Normal Airworthiness category and continues to serve as a dependable training platform.",
    "With a proven safety record and a long history of service, this aircraft reflects PIC’s commitment to providing high-quality, well-maintained training equipment for student pilots at all levels.",
  ],
  bullets: [
    {
      title: "Aircraft Details",
      description:
        "1974 fixed-wing single-engine, 4 seats, Standard/Normal airworthiness, Serial No. 17262919.",
      icon: "Plane",
    },
    {
      title: "Performance",
      description:
        "LYCOMING O-320 series engine, 180 HP, approx. 108 mph cruise speed, <12,500 lbs maximum weight.",
      icon: "Gauge",
    },
    {
      title: "FAA Registration",
      description:
        "N13659 • Certificate issued 09/23/2025 • Airworthiness date 01/31/1974 • Status: Assigned • Mode S: 050112244 / A094A4 • Expires 09/30/2032.",
      icon: "ClipboardCheck",
    },
  ],
  };

const { content = example } = Astro.props;
---
<section>
    <div class="bg-stone-100 bg-logo">
        <div class="flex flex-col justify-center items-center lg:flex-row text-primary-600 pt-12 max-w-7xl mx-auto"> 
        <div class="w-full justify-center flex">
            {!content.coming && (
                <ImageComp 
                    src={content.image.src}
                    alt={content.image.alt}
                    classes="rounded-xl object-cover max-w-[80%] mt-10 shadow-lg shadow-black/30 ring-2 ring-primary-600 my-12"
                />
            )}
            {content.coming && (
                <div class="relative flex justify-center max-w-[80%] my-12 mt-10">
                    {/* Image with overlay */}
                    <div class="relative">
                        {/* Blur overlay */}
                        <div class="absolute inset-0 bg-primary-800/60 rounded-xl blur-3xl z-10"></div>
                        
                        {/* "Coming Soon" text overlay */}
                        <div class="absolute inset-0 flex items-center justify-center z-20">
                            <span class="text-xl md:text-2xl font-bold text-white uppercase -rotate-45 transform bg-primary-900/80 ">
                                {content.coming}
                            </span>
                        </div>
                        
                        {/* Image */}
                        <ImageComp 
                            src={content.image.src}
                            alt={content.image.alt}
                            classes="rounded-xl object-cover lg:w-[60vw] blur-xs shadow-lg shadow-black/30 ring-2 ring-primary-600 opacity-70"
                        />
                    </div>
                </div>
            )}
        </div>
            <div class="flex flex-col px-8 py-12 sm:px-12 lg:py-20 text-center items-center" data-aos="zoom-in" data-aos-delay="300" data-aos-duration="1500">
                <span class="">
                    {content.upperHeader}
                </span>
                <h2
                class="text-4xl font-semibold tracking-tight text-pretty sm:text-5xl"
                >
                {content.title}
                </h2>
                <p class="mt-6 text-lg text-pretty font-extralight max-w-2xl" data-aos="fade-left">
                    {content.description}
                </p>
                
                <ul class="flex flex-col lg:flex-row justify-center items-baseline lg:justify-between gap-6 py-2 mt-6 max-w-3xl border-y border-primary-800" data-aos="zoom-in" data-aos-delay="300" data-aos-duration="1500">
                    {
                        content.bullets.map((bullet: any) => (
                            <div class="flex flex-col items-center">
                                <h3 class="font-semibold text-lg mb-2 uppercase w-44 text-center">
                                    {bullet.title}
                                </h3>
                                <p class="text-gray-500 max-w-sm">
                                    {bullet.description}
                                </p>
                            </div>
                            ))
                    }
                </ul>
                {
                    <div class="grid gap-6 mt-6 lg:grid-cols-2 text-justify py-2  ">
                        {		
                            content.descriptions.map((description: string) => (
                                <p class="mt-4 text-pretty text-lg font-light max-w-xs" data-aos="fade-left">
                                    {description}
                                </p>
                            ))
                        }
                    </div>
                }
                <!-- <div class="mt-10 flex">
                    <a href={content.button.href} class="btn-accent btn-middle ">
                        {content.button.text}
                    </a>
                </div> -->
            </div>
        </div>
    </div>
</section>
