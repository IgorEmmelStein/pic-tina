---
import { website_links } from "../../data/consts";
import ImageComp from "../utils/ImageComp.astro";
import { getCollection } from "astro:content";

// Default fallback SVG path (Modern Aviation Badge Icon)
const DEFAULT_SVG_ICON =
  "M12 2a1 1 0 0 1 .932.638l7 18a1 1 0 0 1-1.326 1.281L13 19.517V13a1 1 0 1 0-2 0v6.517l-5.606 2.402a1 1 0 0 1-1.326-1.281l7-18A1 1 0 0 1 12 2";

// Helper to extract clean pill title from string or object bullets
const getPillTitle = (bullet: any, fallback: string) => {
  if (!bullet) return fallback;
  if (typeof bullet === "string") {
    const colonIdx = bullet.indexOf(":");
    return colonIdx !== -1 ? bullet.slice(0, colonIdx).trim() : bullet.trim();
  }
  return bullet.title || fallback;
};

// 1. Fetch physical aircraft from the "fleet" collection
const fleetEntries = await getCollection("fleet");
const fleetList = fleetEntries.map((entry) => {
  const data = entry.data;
  return {
    id: entry.id.replace(/\.[^/.]+$/, ""),
    title: data.title || "Aircraft",
    description: data.description || "",
    imageSrc: data.imageSrc || "",
    imageAlt: data.imageAlt || data.title || "Aircraft",
    bullets: data.bullets || [],
    targetUrl: `/about/our-fleet/${entry.id.replace(/\.[^/.]+$/, "")}/`,
    isSimulator: false,
    badgeText: "Ready for Training",
    pill1: getPillTitle(data.bullets?.[0], "IFR"),
    pill2: getPillTitle(data.bullets?.[1], "180 HP"),
    icon1: DEFAULT_SVG_ICON,
    icon2: DEFAULT_SVG_ICON,
  };
});

// 2. Fetch simulator entries from the "simulator" collection with safe fallbacks
const simulatorEntries = await getCollection("simulator");
const simulatorList = simulatorEntries.map((entry) => {
  const data = entry.data;
  const simImageSrc =
    data.imageSrc ||
    data.overview?.imageSrc ||
    data.header?.imageSrc ||
    "/src/assets/fleet/red-bird-fmx_pilot-instructional-center.webp";
  const simImageAlt =
    data.imageAlt ||
    data.overview?.imageAlt ||
    data.header?.imageAlt ||
    "Redbird FMX Flight Simulator";

  return {
    id: entry.id.replace(/\.[^/.]+$/, ""),
    title:
      data.title ||
      data.overview?.title ||
      data.header?.title ||
      "Redbird FMX Simulator",
    description:
      data.description ||
      data.overview?.description ||
      data.header?.description ||
      "",
    imageSrc: simImageSrc,
    imageAlt: simImageAlt,
    bullets: data.bullets || data.overview?.bullets || [],
    targetUrl: "/about/our-fleet/simulator-redbird-fmx-full-motion-aatd/",
    isSimulator: true,
    badgeText: "AATD Simulator",
    pill1: getPillTitle(data.bullets?.[0] || data.overview?.bullets?.[0], "Full Motion"),
    pill2: getPillTitle(data.bullets?.[1] || data.overview?.bullets?.[1], "FAA Loggable"),
    icon1: DEFAULT_SVG_ICON,
    icon2: DEFAULT_SVG_ICON,
  };
});

// 3. Combine both collections into a single fleet list
const allFleet = [...fleetList, ...simulatorList];

const {
  button = {
    title: "Book a Discovery Flight",
    path: website_links?.discoveryFlight?.path || "/discovery-flight/",
  },
} = Astro.props;
---

<section class="bg-[#fcfaf8] py-12 lg:py-24 font-sans">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2
        class="text-3xl font-bold tracking-tight text-primary-800 sm:text-4xl uppercase"
      >
        Explore Our <span class="text-accent-500">Fleet</span>
      </h2>
      <p class="mt-4 text-primary-600/70">
        Select an aircraft or simulator to view full specifications and training
        capabilities.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-6 lg:gap-4">
      {
        allFleet.map((item: any) => {
          return (
            <a
              href={item.targetUrl}
              class="group relative w-full lg:max-w-2xs aspect-4/5 rounded-3xl overflow-hidden bg-primary-800 shadow-2xl shadow-neutral-950 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:inset-shadow-sm hover:inset-shadow-white hover:shadow-accent-800"
            >
              <svg
                class="absolute inset-0 w-full h-full z-50 pointer-events-none"
                fill="none"
              >
                <rect
                  x="1"
                  y="1"
                  rx="31"
                  width="100%"
                  height="100%"
                  class="stroke-accent-400 rounded-4xl stroke-12 opacity-0 transition-all duration-700 group-hover:opacity-100"
                  style="stroke-dasharray: 3000;stroke-dashoffset: 3000;"
                />
              </svg>

              <div class="absolute inset-0 z-0">
                {item.imageSrc && (
                  <ImageComp
                    src={item.imageSrc}
                    alt={item.imageAlt || item.title}
                    classes="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-60"
                  />
                )}
              </div>

              <div class="absolute inset-0 z-10 bg-gradient-to-t from-primary-800 via-transparent to-black/20" />

              <div class="absolute inset-0 z-20 p-8 flex flex-col justify-end">
                <span class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-2 translate-y-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                  {item.badgeText}
                </span>

                <h3
                  class="text-2xl font-bold text-white mb-2 leading-tight"
                  set:html={item.title}
                />

                <div class="max-h-0 overflow-hidden transition-all duration-500 group-hover:max-h-40">
                  <p
                    class="text-white/80 text-sm line-clamp-2 mb-4 font-light"
                    set:html={item.description}
                  />

                  <div class="flex flex-wrap gap-2 items-center">
                    {item.pill1 && (
                      <span class="px-3 py-1 rounded-full bg-white/10 border border-white/20 text-[10px] text-white uppercase font-semibold inline-flex items-center gap-1.5">
                        <svg
                          class="w-3 h-3 text-accent-400 fill-current"
                          viewBox="0 0 24 24"
                        >
                          <path d={item.icon1} />
                        </svg>
                        <span>{item.pill1}</span>
                      </span>
                    )}

                    {item.pill2 && (
                      <span class="px-3 py-1 rounded-full bg-white/10 border border-white/20 text-[10px] text-white uppercase font-semibold inline-flex items-center gap-1.5">
                        <svg
                          class="w-3 h-3 text-accent-400 fill-current"
                          viewBox="0 0 24 24"
                        >
                          <path d={item.icon2} />
                        </svg>
                        <span>{item.pill2}</span>
                      </span>
                    )}
                  </div>
                </div>

                <div class="mt-4 h-1 w-12 bg-accent-500 transition-all duration-500 group-hover:w-full" />
              </div>
            </a>
          );
        })
      }
    </div>
  </div>

  <div class="flex justify-center pt-12">
    <a
      href={button.path}
      class="group relative inline-flex items-center justify-center px-10 py-5 bg-primary-800 text-white font-bold rounded-full overflow-hidden transition-all hover:bg-accent-500 shadow-xl"
    >
      <span
        class="relative z-10 uppercase tracking-[0.2em] text-sm"
        set:html={button.title}
      />
      <div
        class="absolute bottom-0 left-0 h-1 bg-primary-400 w-0 transition-all duration-500 group-hover:w-full"
      >
      </div>
    </a>
  </div>
</section>

<style>
  .group:hover rect {
    animation: drawBorder 1.2s ease-in-out forwards;
  }

  @keyframes drawBorder {
    from {
      stroke-dashoffset: 2000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>