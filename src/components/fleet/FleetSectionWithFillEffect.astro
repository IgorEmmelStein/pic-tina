---
import ImageComp from "../utils/ImageComp.astro";

const { fleet } = Astro.props;

// Helper to check if index is even
const isEven = (index) => index % 2 === 0;
---

<section class="bg-[#fcfaf8] py-24 sm:py-32 overflow-hidden font-sans">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 flex flex-col gap-32 lg:gap-40">
    {
      fleet.map((aircraft, index) => (
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
          id={aircraft.id}
        >
          {/* Image Column */}
          <div
            class:list={[
              "relative group w-full flex justify-center p-2",
              !isEven(index) && "lg:order-last",
            ]}
            data-aos={isEven(index) ? "fade-right" : "fade-left"}
            data-aos-duration="1000"
          >
            {/* Background Decorative Blob */}
            <div class="absolute inset-0 bg-accent-400/60 rounded-[3rem] transform -rotate-3 scale-105 transition-transform duration-700 group-hover:rotate-0" />

            <div class="relative z-10 w-full max-w-[90%] lg:max-w-full rounded-3xl overflow-hidden shadow-2xl ring-1 ring-black/5">
              {/* The Animated Border SVG - Perfectly aligned to the image radius */}
              <svg class="absolute inset-0 w-full h-full z-50 pointer-events-none">
                <rect
                  x="1"
                  y="1"
                  width="100%"
                  height="100%"
                  rx="40"
                  fill="none"
                  class="fleet-border  stroke-accent-400 stroke-10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                  style="stroke-dasharray: 3000; stroke-dashoffset: 3000;"
                />
              </svg>
              <ImageComp
                src={aircraft.image.src}
                alt={aircraft.image.alt}
                classes="w-full h-full object-cover aspect-[4/3] transition-transform duration-700 group-hover:scale-105"
              />

              {aircraft.coming && (
                <div class="absolute inset-0 z-20 backdrop-blur-sm bg-[#423731]/40 flex items-center justify-center">
                  <div class="px-8 py-4 bg-white/10 backdrop-blur-md rounded-full border border-white/30 shadow-2xl transform -rotate-12">
                    <span class="text-white font-bold uppercase tracking-widest text-lg md:text-xl drop-shadow-md">
                      {aircraft.coming}
                    </span>
                  </div>
                </div>
              )}
            </div>
          </div>

          {/* Text Column */}
          <div
            class:list={["flex flex-col", !isEven(index) && "lg:order-first"]}
            data-aos="fade-up"
            data-aos-duration="1000"
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="h-px w-8 bg-[#4b7992]" />
              <span class="text-[#4b7992] font-bold tracking-widest uppercase text-xs">
                {aircraft.upperHeader}
              </span>
            </div>

            <h2 class="text-4xl sm:text-5xl font-bold tracking-tight text-[#423731] mb-6">
              {aircraft.title}
            </h2>

            <p class="text-xl text-[#423731] leading-relaxed mb-8 font-medium">
              {aircraft.description}
            </p>

            <div class="space-y-4 text-lg text-[#5d4d40]/90 font-light leading-relaxed mb-10">
              {aircraft.descriptions.map((desc) => (
                <p>{desc}</p>
              ))}
            </div>

            {/* Features List (Only renders if 'features' array exists, like on N46091) */}
            {aircraft.features && (
              <div class="mb-10 p-6 bg-white rounded-2xl border border-[#dcc1a6]/30 shadow-sm">
                <h4 class="text-[#423731] font-bold uppercase tracking-wider text-sm mb-4">
                  Avionics & Upgrades
                </h4>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {aircraft.features.map((feature) => (
                    <li class="flex items-start gap-3 text-sm text-[#5d4d40]">
                      <svg
                        class="w-5 h-5 text-[#4b7992] flex-shrink-0 mt-0.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {/* Bullets Grid */}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-8 border-t border-[#dcc1a6]/40">
              {aircraft.bullets.map((bullet) => (
                <div class="flex flex-col group/bullet">
                  {/* Abstract Icon Placeholder based on your brand */}
                  <div class="w-10 h-10 rounded-full bg-[#4b7992]/10 flex items-center justify-center mb-4 transition-colors group-hover/bullet:bg-[#4b7992] text-[#4b7992] group-hover/bullet:text-white">
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                  </div>
                  <h3 class="font-bold text-[#423731] mb-2 text-sm uppercase tracking-wide">
                    {bullet.title}
                  </h3>
                  <p class="text-sm text-[#5d4d40]/80 leading-relaxed">
                    {bullet.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Added the dot (.) before group so it targets your Tailwind class! */
  .group:hover rect {
    animation: drawBorder 1.2s ease-in-out forwards;
  }

  @keyframes drawBorder {
    from {
      stroke-dashoffset: 3000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
