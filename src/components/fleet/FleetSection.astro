---
import ImageComp from "../utils/ImageComp.astro";

const { fleet } = Astro.props;

// Helper to check if index is even
const isEven = (index) => index % 2 === 0;
---

<section class="bg-[#fcfaf8] py-24 sm:py-32 overflow-hidden font-sans">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 flex flex-col gap-32 lg:gap-40">
    {
      fleet.map((aircraft, index) => (
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
          id={aircraft.id}
        >
          <div class="flex flex-col gap-6 lg:gap-12">
            {/* Image Column */}
            <div
              class:list={[
                "relative group w-full flex justify-center lg:mt-12 ",
                !isEven(index) && "lg:order-last", // Alternates layout
              ]}
              data-aos={isEven(index) ? "fade-right" : "fade-left"}
              data-aos-duration="1000"
            >
              {/* Background Decorative Blob */}
              <div class="absolute inset-0 bg-accent-400/60 rounded-4xl transform -translate-y-4 lg:-translate-y-12 translate-x-3 lg:translate-x-10 -rotate-3  transition-transform duration-700 group-hover:rotate-0" />

              <div class="relative w-full max-w-[90%] lg:max-w-full bg-white rounded-4xl overflow-hidden shadow-2xl ring-1 ring-black/5">
                <ImageComp
                  src={aircraft.image.src}
                  alt={aircraft.image.alt}
                  classes="w-full h-full object-cover  p-6 rounded-4xl transition-transform duration-700 group-hover:scale-105"
                />

                {/* Refined "Coming Soon" Overlay */}
                {aircraft.coming && (
                  <div class="absolute inset-0 z-20 backdrop-blur-sm bg-[#423731]/40 flex items-center justify-center">
                    <div class="px-8 py-4 bg-white/10 backdrop-blur-md rounded-full border border-white/30 shadow-2xl transform -rotate-12">
                      <span class="text-white font-bold uppercase tracking-widest text-lg md:text-xl drop-shadow-md">
                        {aircraft.coming}
                      </span>
                    </div>
                  </div>
                )}
              </div>
            </div>
            {/* Features List (Only renders if 'features' array exists, like on N46091) */}
            {aircraft.features && (
              <div class=" p-6 bg-white rounded-2xl border border-[#dcc1a6]/30 shadow-sm">
                <h4 class="text-[#423731] font-bold uppercase tracking-wider text-sm mb-4">
                  Avionics & Upgrades
                </h4>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {aircraft.features.map((feature) => (
                    <li class="flex items-start gap-3 text-sm text-[#5d4d40]">
                      <svg
                        class="w-5 h-5 text-[#4b7992] flex-shrink-0 mt-0.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          {/* Text Column */}
          <div
            class:list={["flex flex-col order-first", !isEven(index) && ""]}
            data-aos="fade-up"
            data-aos-duration="1000"
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="h-px w-8 bg-[#4b7992]" />
              <span class="text-[#4b7992] font-bold tracking-widest uppercase text-xs">
                {aircraft.upperHeader}
              </span>
            </div>

            <h2 class="text-4xl sm:text-5xl font-bold tracking-tight text-[#423731] mb-6">
              {aircraft.title}
            </h2>

            <p class="text-xl text-[#423731] leading-relaxed mb-8 font-medium">
              {aircraft.description}
            </p>

            {aircraft.path && (
              <a
                href={aircraft.path}
                class="inline-block  px-8 py-4 bg-[#4b7992] text-white font-bold rounded-r-full shadow-lg transition-transform duration-300 hover:scale-105"
              >
                {aircraft.title}
              </a>
            )}
            {/* Bullets Grid */}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 py-12 border-t border-[#dcc1a6]/40">
              {aircraft.bullets.map((bullet) => (
                <div class="flex flex-col group/bullet">
                  {/* Abstract Icon Placeholder based on your brand */}
                  <div class="w-10 h-10 rounded-full bg-[#4b7992]/10 flex items-center justify-center mb-4 transition-colors group-hover/bullet:bg-[#4b7992] text-[#4b7992] group-hover/bullet:text-white">
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                  </div>
                  <h3 class="font-bold text-[#423731] mb-2 text-sm uppercase tracking-wide">
                    {bullet.title}
                  </h3>
                  <p class="text-sm text-[#5d4d40]/80 leading-relaxed">
                    {bullet.description}
                  </p>
                </div>
              ))}
            </div>

            <div class="hidden lg:block space-y-4 text-lg text-[#5d4d40]/90 font-light leading-relaxed mb-10">
              {aircraft.descriptions.map((desc) => (
                <p>{desc}</p>
              ))}
            </div>
            <div class="flex justify-start flex-col gap-6">
              <a
                href="/discovery-flight/"
                class="inline-block  px-8 py-4 bg-[#4b7992] text-white font-bold rounded-r-full shadow-lg transition-transform duration-300 hover:scale-105"
              >
                Book a Discovery Flight
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
