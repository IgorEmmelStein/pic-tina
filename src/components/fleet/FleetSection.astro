---
import ImageComp from "../utils/ImageComp.astro";

const { aircraft, index = 0 } = Astro.props;

const iconList = [
  `<svg class="w-5 h-5 text-accent-500 group-hover/bullet:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>`,
  `<svg class="w-5 h-5 text-accent-500 group-hover/bullet:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  `<svg class="w-5 h-5 text-accent-500 group-hover/bullet:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012-2m-6 9l2 2 4-4"/></svg>`
];

const isEven = index % 2 === 0;
const aircraftId = aircraft.id ? aircraft.id.replace(/\.[^/.]+$/, "") : "";
---

<section class="bg-[#fcfaf8] py-24 sm:py-32 overflow-hidden font-sans">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
      id={aircraftId}
    >
      <div class="flex flex-col gap-6 lg:gap-12">
        <div
          class:list={[
            "relative group w-full flex justify-center lg:mt-12",
            !isEven && "lg:order-last",
          ]}
          data-aos={isEven ? "fade-right" : "fade-left"}
          data-aos-duration="1000"
        >
          <div class="absolute inset-0 bg-accent-400/60 rounded-4xl transform -translate-y-4 lg:-translate-y-12 translate-x-3 lg:translate-x-10 -rotate-3 transition-transform duration-700 group-hover:rotate-0" />

          <div class="relative w-full max-w-[90%] lg:max-w-full bg-white rounded-4xl overflow-hidden shadow-2xl ring-1 ring-black/5">
            {aircraft.imageSrc && (
              <ImageComp
                src={aircraft.imageSrc}
                alt={aircraft.imageAlt || aircraft.title}
                classes="w-full h-full object-cover p-6 rounded-4xl transition-transform duration-700 group-hover:scale-105"
              />
            )}

            {aircraft.coming && (
              <div class="absolute inset-0 z-20 backdrop-blur-sm bg-primary-800/40 flex items-center justify-center">
                <div class="px-8 py-4 bg-white/10 backdrop-blur-md rounded-full border border-white/30 shadow-2xl transform -rotate-12">
                  <span class="text-white font-bold uppercase tracking-widest text-lg md:text-xl drop-shadow-md" set:html={aircraft.coming} />
                </div>
              </div>
            )}
          </div>
        </div>

        {aircraft.features && aircraft.features.length > 0 && (
          <div class="p-6 bg-white rounded-2xl border border-primary-400/30 shadow-sm">
            <h4 class="text-primary-800 font-bold uppercase tracking-wider text-sm mb-4">
              Avionics & Upgrades
            </h4>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {aircraft.features.map((feature: string) => (
                <li class="flex items-start gap-3 text-sm text-primary-600">
                  <svg
                    class="w-5 h-5 text-accent-500 flex-shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span set:html={feature} />
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div
        class:list={["flex flex-col order-first", !isEven && ""]}
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <div class="flex items-center gap-4 mb-4">
          <div class="h-px w-8 bg-accent-500" />
          <span class="text-accent-500 font-bold tracking-widest uppercase text-xs" set:html={aircraft.upperHeader} />
        </div>

        <h2 class="text-4xl sm:text-5xl font-bold tracking-tight text-primary-800 mb-6" set:html={aircraft.title} />

        <p class="text-xl text-primary-800 leading-relaxed mb-8 font-medium" set:html={aircraft.description} />

        {aircraft.path && (
          <a
            href={aircraft.path}
            class="inline-block px-8 py-4 bg-accent-500 text-white font-bold rounded-r-full shadow-lg transition-transform duration-300 hover:scale-105 w-fit"
            set:html={aircraft.title}
          />
        )}

        {aircraft.bullets && aircraft.bullets.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 py-12 border-t border-primary-400/40">
            {aircraft.bullets.map((item: any, i: number) => {
              // Handles string strings like "Title: Description" or bullet objects
              const isString = typeof item === "string";
              const colonIndex = isString ? item.indexOf(":") : -1;
              const title = isString
                ? (colonIndex !== -1 ? item.slice(0, colonIndex).trim() : `Feature ${i + 1}`)
                : item.title;
              const desc = isString
                ? (colonIndex !== -1 ? item.slice(colonIndex + 1).trim() : item)
                : item.description;
              const iconSvg = iconList[i % iconList.length];

              return (
                <div class="flex flex-col group/bullet">
                  <div class="w-10 h-10 rounded-full bg-accent-500/10 flex items-center justify-center mb-4 transition-colors group-hover/bullet:bg-accent-500">
                    <span class="w-5 h-5 inline-flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={iconSvg} />
                  </div>
                  <h3 class="font-bold text-primary-800 mb-2 text-sm uppercase tracking-wide" set:html={title} />
                  <p class="text-sm text-primary-600/80 leading-relaxed" set:html={desc} />
                </div>
              );
            })}
          </div>
        )}

        {aircraft.descriptions && aircraft.descriptions.length > 0 && (
          <div class="hidden lg:block space-y-4 text-lg text-primary-600/90 font-light leading-relaxed mb-10">
            {aircraft.descriptions.map((desc: string) => (
              <p set:html={desc} />
            ))}
          </div>
        )}

        <div class="flex justify-start flex-col gap-6">
          <a
            href="/discovery-flight/"
            class="inline-block px-8 py-4 bg-accent-500 text-white font-bold rounded-r-full shadow-lg transition-transform duration-300 hover:scale-105 w-fit"
          >
            Book a Discovery Flight
          </a>
        </div>
      </div>
    </div>
  </div>
</section>