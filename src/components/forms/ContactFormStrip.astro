---
import {
  COMPANY_NAME,
  PHONE_NUMBER,
  EMAIL_ADDRESS,
  website_links,
} from "../../data/consts";
import ImageComp from "../utils/ImageComp.astro";

const backgroundFixedImage = {
  src: "/src/assets/rrm-visit/pilot-instructional-center_new-century-KS_cfis-preparing-plane-cessna-airport-near-Kansas-city-MO-cropped.png",
  alt: "Pilot Instructional Center New Century KS - CFIs preparing Cessna plane at airport near Kansas City MO original",
};

const FORM_WEBHOOK_URL = import.meta.env.CONTACT_FORM_WEBHOOK_URL;
const PORTAL_API_KEY = import.meta.env.PORTAL_API_KEY;
const inputClass =
  "block w-full rounded-2xl border-0 bg-white/5 px-6 py-4 text-white shadow-sm ring-1 ring-inset ring-white/10 placeholder:text-[#dcc1a6]/50 focus:ring-2 focus:ring-inset focus:ring-[#dcc1a6] focus:bg-white/10 transition-all duration-300 sm:text-sm outline-none";
---

<div id="contact" class="py-24 sm:py-32 relative overflow-hidden font-sans">
  <!-- Fixed Background Image -->
  <div class="fixed inset-0 -z-50 pointer-events-none">
    <ImageComp
      src={backgroundFixedImage.src}
      alt={backgroundFixedImage.alt}
      classes="w-full h-full object-cover mix-blend-multiply"
    />
    <div class="absolute inset-0 bg-black/70 mix-blend-multiply"></div>
  </div>

  {/* Ambient Background Glows */}
  <div
    class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 h-[500px] w-[500px] rounded-full bg-[#4b7992] opacity-20 blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 h-[400px] w-[400px] rounded-full bg-[#dcc1a6] opacity-10 blur-[80px] pointer-events-none"
  >
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-8 items-center">
      {/* Left Column: Copy, Image & Animation */}
      <div
        class="flex flex-col justify-center"
        data-aos="fade-right"
        data-aos-duration="1000"
      >
        <div class="flex items-center gap-4 mb-6">
          <span
            class="text-[#dcc1a6] font-bold tracking-widest uppercase text-sm"
            >Let's Connect</span
          >
          <div class="h-px w-12 bg-[#dcc1a6]/50"></div>
        </div>

        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight font-title text-white uppercase leading-tight"
        >
          Your Journey <br />
          <span class="text-[#dcc1a6] italic font-serif">Starts Here</span>
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-white/70 max-w-md">
          Whether you're taking your first discovery flight or advancing your
          ratings, our team is ready to guide you.
        </p>
        <div class="text-left mt-8">
          <p
            class="text-accent-500 brightness-150 font-semibold text-xs lg:text-base tracking-[0.3em] uppercase"
          >
            Take a <a href={website_links.discoveryFlight.path} class=""
              >Discovery Flight</a
            > and get your money back after enrolling!
          </p>
        </div>
        {/* Animated Graphic & Image Arrangement */}
        <div class="mt-12 relative max-w-sm">
          {/* Main Image (Replace src with your actual image) */}
          <div
            class="relative rounded-[2.5rem] overflow-hidden border border-white/10 shadow-2xl aspect-[4/3] group"
          >
            <div
              class="absolute inset-0 bg-[#4b7992]/20 group-hover:bg-transparent transition-colors duration-500 z-10"
            >
            </div>
            <ImageComp
              src="/src/assets/drive/Riley-Riggs-Discovery-Flight-Pilot-instructional-center_flight-school_PIC-Kansas-city-Missouri.jpeg"
              alt="Pilot looking at the sunset"
              classes="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
        </div>
      </div>

      {/* Right Column: Glassmorphism Form */}
      <div
        class="relative"
        data-aos="fade-left"
        data-aos-duration="1000"
        data-aos-delay="200"
      >
        <form
          class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-[2.5rem] p-8 sm:p-12 shadow-2xl relative overflow-hidden"
          name="contact-form"
          id="contact-form"
        >
          {/* Internal Form Glow */}
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-[#4b7992]/20 blur-3xl rounded-full"
          >
          </div>

          <div
            class="relative z-10 grid grid-cols-1 gap-y-6 sm:grid-cols-2 gap-x-6"
          >
            <p class="hidden"><input name="confirm-email" /></p>

            <div>
              <input
                type="text"
                name="first-name"
                id="df-first-name"
                required
                placeholder="First Name"
                class={inputClass}
              />
            </div>
            <div>
              <input
                type="text"
                name="last-name"
                id="df-last-name"
                required
                placeholder="Last Name"
                class={inputClass}
              />
            </div>

            <div class="sm:col-span-2">
              <input
                type="email"
                name="email"
                id="df-email"
                required
                placeholder="Email Address"
                class={inputClass}
              />
            </div>

            <div class="sm:col-span-2">
              <input
                type="tel"
                name="phone"
                id="df-phone"
                required
                placeholder="Phone Number"
                class={inputClass}
              />
            </div>

            <div class="sm:col-span-2">
              <textarea
                name="additional-information"
                id="df-additional-information"
                rows="4"
                placeholder="How can we help you fly?"
                class={inputClass}></textarea>
            </div>
          </div>

          {/* Custom Toggle & Terms */}
          <div
            class="relative z-10 flex gap-x-4 mt-8 items-start sm:items-center"
          >
            <button
              type="button"
              id="terms-toggle"
              class="flex w-12 flex-none cursor-pointer rounded-full p-1 ring-1 ring-inset ring-white/20 transition-all duration-300 bg-black/20 hover:bg-black/40 mt-1 sm:mt-0"
              role="switch"
              aria-checked="false"
            >
              <span
                id="terms-thumb"
                class="h-5 w-5 rounded-full bg-[#dcc1a6] shadow-sm transition-transform duration-300 translate-x-0"
              ></span>
            </button>
            <label class="text-sm leading-relaxed text-white/70">
              I agree to the <a
                href="/privacy-policy/"
                target="_blank"
                class="text-[#dcc1a6] font-semibold hover:text-white transition-colors"
                >Privacy Policy</a
              > and <a
                href="/terms-of-service/"
                target="_blank"
                class="text-[#dcc1a6] font-semibold hover:text-white transition-colors"
                >Terms of Service</a
              >.
            </label>
          </div>

          <div class="relative z-10 mt-10">
            <button
              type="submit"
              id="submit-btn"
              disabled
              class="group relative flex w-full items-center justify-center gap-3 rounded-full bg-[#4b7992] px-8 py-4 text-white font-bold tracking-wide shadow-lg transition-all duration-300 overflow-hidden disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 hover:bg-[#3a5f73] hover:shadow-[#4b7992]/40 hover:scale-[1.02]"
            >
              <span class="relative z-10">Send Message</span>
              {/* Button Hover Arrow Animation */}
              <svg
                class="w-5 h-5 relative z-10 transform transition-transform duration-300 group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
              >
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
</style>

<script define:vars={{ FORM_WEBHOOK_URL, PORTAL_API_KEY }}>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("terms-toggle");
    const thumb = document.getElementById("terms-thumb");
    const submitBtn = document.getElementById("submit-btn");
    const form = document.getElementById("contact-form");

    if (!toggle || !thumb || !submitBtn || !form) {
      console.error("Form elements missing.");
      return;
    }

    let isChecked = false;

    // Toggle Functionality
    toggle.addEventListener("click", () => {
      isChecked = !isChecked;

      // Update Accessibility
      toggle.setAttribute("aria-checked", isChecked.toString());

      // Visual States
      if (isChecked) {
        toggle.classList.add("bg-[#4b7992]");
        toggle.classList.remove("bg-black/20");
        thumb.classList.add("translate-x-6");
        thumb.classList.remove("translate-x-0");
      } else {
        toggle.classList.remove("bg-[#4b7992]");
        toggle.classList.add("bg-black/20");
        thumb.classList.remove("translate-x-6");
        thumb.classList.add("translate-x-0");
      }

      // Enable/Disable Submit Button
      submitBtn.disabled = !isChecked;
    });

    // Form Submission Logic
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      // Honeypot check
      const confirmEmail = formData.get("confirm-email")?.trim();
      if (confirmEmail) return;

      const urlEncodedBody = new URLSearchParams(formData).toString();

      // Metadata filtering
      const excludedFields = [
        "first-name",
        "last-name",
        "email",
        "phone",
        "confirm-email",
      ];
      const metadata = {};
      for (const [key, value] of formData.entries()) {
        if (!excludedFields.includes(key)) {
          metadata[key] = value;
        }
      }

      const jsonBody = {
        first_name: formData.get("first-name")?.trim() || "",
        last_name: formData.get("last-name")?.trim() || "",
        email: formData.get("email")?.trim() || "",
        phone: formData.get("phone")?.trim() || "",
        campaign: "contact",
        account_random_id: "ac_cpxc2poi",
        metadata: metadata,
      };

      try {
        const [ghlRes, portalRes] = await Promise.all([
          fetch(FORM_WEBHOOK_URL, {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: urlEncodedBody,
          }),
          fetch("https://portal.rightruddermarketing.com/api/leads", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
              "x-api-key": PORTAL_API_KEY,
            },
            body: JSON.stringify(jsonBody),
          }),
        ]);

        if (ghlRes.ok && portalRes.ok) {
          window.location.href = "/contact-confirmation/";
        } else {
          alert("There was an error sending your message. Please try again.");
        }
      } catch (err) {
        console.error("Submission error:", err);
      }
    });
  });
</script>