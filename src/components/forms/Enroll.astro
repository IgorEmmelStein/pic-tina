---
import {
  COMPANY_NICKNAME,
  LOCATIONS,
  PHONE_NUMBER,
  EMAIL_ADDRESS,
  website_links,
} from "../../data/consts";
import EnrollForm from "./EnrollForm.astro";
import ImageComp from "../utils/ImageComp.astro";

const backgroundFixedImage = {
  src: "/src/assets/rrm-visit/pilot-instructional-center_new-century-KS_cfis-preparing-plane-cessna-airport-near-Kansas-city-MO-cropped.png",
  alt: "Pilot Instructional Center New Century KS - CFIs preparing Cessna plane at airport near Kansas City MO original",
};
---

<div id="enroll" class="py-24 sm:py-32 relative overflow-hidden font-sans">
  <div class="fixed inset-0 -z-50 pointer-events-none">
    <ImageComp
      src={backgroundFixedImage.src}
      alt={backgroundFixedImage.alt}
      classes="w-full h-full object-cover mix-blend-multiply"
    />
    <div class="absolute inset-0 bg-black/70 mix-blend-multiply"></div>
  </div>

  {/* Ambient Background Glows - Matching the Contact Us style */}
  <div
    class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 h-[500px] w-[500px] rounded-full bg-[#4b7992] opacity-20 blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 h-[400px] w-[400px] rounded-full bg-[#dcc1a6] opacity-10 blur-[80px] pointer-events-none"
  >
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-8 items-center">
      {/* Left Column: Branding & Copy */}
      <div
        class="flex flex-col justify-center"
        data-aos="fade-right"
        data-aos-duration="1000"
      >
        <div class="flex items-center gap-4 mb-6">
          <span
            class="text-[#dcc1a6] font-bold font-title tracking-widest uppercase text-sm"
            >Enrollment Open</span
          >
          <div class="h-px w-12 bg-[#dcc1a6]/50"></div>
        </div>

        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight font-title text-white uppercase leading-tight"
        >
          Master the <br />
          <span class="text-[#dcc1a6] italic font-serif"
            >Skies with {COMPANY_NICKNAME}</span
          >
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-white/70 max-w-md">
          Join a community of dedicated aviators. From your first solo to
          professional instructor ratings, our structured programs are designed
          for your success.
        </p>
        <div class="text-left mt-8">
          <p
            class="text-accent-500 brightness-150 font-semibold text-xs lg:text-base tracking-[0.3em] uppercase"
          >
            Take a <a href={website_links.discoveryFlight.path} class=""
              >Discovery Flight</a
            > and get your money back after enrolling!
          </p>
        </div>
        {
          /* The "NAP" (Name, Address, Phone) integrated into the left side style */
        }
        <div class="mt-10 space-y-6">
          {
            LOCATIONS.map((location) => (
              <div class="border-l border-[#dcc1a6]/30 pl-6">
                <h4 class="text-white font-bold uppercase tracking-wider text-sm">
                  {location.title}
                </h4>
                <p class="text-white/60 text-sm mt-1">
                  {location.address}, {location.city}
                </p>
              </div>
            ))
          }
          <div class="pt-4">
            <a
              href={`tel:${PHONE_NUMBER}`}
              class="text-2xl font-bold text-white hover:text-[#dcc1a6] transition-colors tracking-tighter"
            >
              {PHONE_NUMBER}
            </a>
          </div>
        </div>
      </div>

      {/* Right Column: Glassmorphism Enroll Form */}
      <div
        class="relative"
        data-aos="fade-left"
        data-aos-duration="1000"
        data-aos-delay="200"
      >
        <div
          class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-[2.5rem] p-8 sm:p-12 shadow-2xl relative overflow-hidden"
        >
          {/* Internal Form Glow */}
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-[#4b7992]/20 blur-3xl rounded-full"
          >
          </div>

          <div class="relative z-10 mb-8">
            <h3 class="text-xl font-bold text-white uppercase tracking-tight">
              Registration Form
            </h3>
            <p class="text-white/50 text-sm">
              Please provide your details to begin.
            </p>
          </div>

          <EnrollForm />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);

  const contactUs = document.getElementById("contactUs");

  if (isSafari && contactUs) {
    contactUs.classList.remove("bg-fixed");
  }
</script>
