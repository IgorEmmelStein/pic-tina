---
import { COMPANY_NAME, PHONE_NUMBER, EMAIL_ADDRESS } from "../../data/consts";

const FORM_WEBHOOK_URL = import.meta.env.DISCOVERY_FLIGHT_FORM_WEBHOOK_URL;
const PORTAL_API_KEY = import.meta.env.PORTAL_API_KEY;
---

<section
  id="discovery-flight"
  class="bg-[#fcfaf8] py-24 font-sans overflow-hidden"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2
        class="text-3xl font-bold tracking-tight text-[#423731] sm:text-5xl uppercase"
      >
        Take the <span class="text-[#4b7992]">Controls</span>
      </h2>
      <p class="mt-4 text-[#5d4d40]/70 max-w-2xl mx-auto">
        Your journey toward the flight deck begins with a single lesson. Fill
        out the form below to schedule your Discovery Flight.
      </p>
      <div class="mt-6 h-1.5 w-24 bg-[#4b7992] mx-auto rounded-full"></div>
    </div>

    <div class="grid lg:grid-cols-12 gap-12 items-start">
      <div
        class="lg:col-span-7 group relative bg-white p-8 md:p-12 rounded-3xl shadow-2xl shadow-neutral-200 transition-all duration-500 hover:-translate-y-1"
      >
        <svg
          class="absolute inset-0 w-full h-full z-50 pointer-events-none"
          fill="none"
        >
          <rect
            x="2"
            y="2"
            rx="22"
            width="calc(100% - 4px)"
            height="calc(100% - 4px)"
            class="stroke-[#4b7992] stroke-[4px] opacity-0 transition-all duration-700 group-hover:opacity-100"
            style="stroke-dasharray: 3000; stroke-dashoffset: 3000;"></rect>
        </svg>

        <form id="discovery-flight-form" class="relative z-10 space-y-8">
          <p class="hidden">
            <label><input name="confirm-email" tabindex="-1" /></label>
          </p>

          <div class="grid sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label
                for="first-name"
                class="text-xs font-bold uppercase tracking-widest text-[#423731]"
                >First Name</label
              >
              <input
                type="text"
                name="first-name"
                required
                class="w-full bg-[#fcfaf8] border-none rounded-xl py-4 px-5 focus:ring-2 focus:ring-[#4b7992] transition-all"
                placeholder="John"
              />
            </div>
            <div class="space-y-2">
              <label
                for="last-name"
                class="text-xs font-bold uppercase tracking-widest text-[#423731]"
                >Last Name</label
              >
              <input
                type="text"
                name="last-name"
                required
                class="w-full bg-[#fcfaf8] border-none rounded-xl py-4 px-5 focus:ring-2 focus:ring-[#4b7992] transition-all"
                placeholder="Doe"
              />
            </div>
            <div class="space-y-2">
              <label
                for="email"
                class="text-xs font-bold uppercase tracking-widest text-[#423731]"
                >Email Address</label
              >
              <input
                type="email"
                name="email"
                required
                class="w-full bg-[#fcfaf8] border-none rounded-xl py-4 px-5 focus:ring-2 focus:ring-[#4b7992] transition-all"
                placeholder="john@example.com"
              />
            </div>
            <div class="space-y-2">
              <label
                for="phone"
                class="text-xs font-bold uppercase tracking-widest text-[#423731]"
                >Phone</label
              >
              <input
                type="tel"
                id="df-phone"
                name="phone"
                required
                class="w-full bg-[#fcfaf8] border-none rounded-xl py-4 px-5 focus:ring-2 focus:ring-[#4b7992] transition-all"
                placeholder="(555) 000-0000"
              />
            </div> 
            <div class="sm:col-span-1 space-y-2 flex flex-col">
              <label
                for="preferred-day"
                class="text-xs font-bold uppercase tracking-widest text-[#423731]"
                >Preferred Day</label
              >
              <select
                id="flight_date"
                name="preferred-day"
                required
                class="mt-2 h-12 rounded-lg border-slate-200 bg-slate-50 px-4 text-slate-900 focus:border-primary-500 focus:ring-primary-500"
              >
                <option value="Sunday">Sunday</option>
                <option value="Monday">Monday</option>
                <option value="Tuesday">Tuesday</option>
                <option value="Wednesday">Wednesday</option>
                <option value="Thursday">Thursday</option>
                <option value="Friday">Friday</option>
                <option value="Saturday">Saturday</option>
              </select>
            </div>
            <div class="sm:col-span-1 space-y-2 flex flex-col">
              <label
                for="preferred-time"
                class="text-xs font-bold uppercase tracking-widest text-[#423731]"
                >Preferred Time</label
              >
              <select
                id="flight_time"
                name="preferred-time"
                required
                class="mt-2 h-12 rounded-lg border-slate-200 bg-slate-50 px-4 text-slate-900 focus:border-primary-500 focus:ring-primary-500"
              >
                <option value="Morning">Morning</option>
                <option value="Early Afternoon">Early Afternoon</option>
                <option value="Late Afternoon">Late Afternoon</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-4 group/terms">
            <button
              type="button"
              id="terms-toggle"
              class="relative inline-flex h-6 w-11 items-center rounded-full bg-gray-200 transition-colors duration-300"
              role="switch"
            >
              <span
                id="terms-thumb"
                class="inline-block h-4 w-4 transform rounded-full bg-white transition duration-300 translate-x-1"
              ></span>
            </button>
            <input
              type="hidden"
              id="agree-terms"
              name="agree-terms"
              value="no"
            />
            <label
              class="text-xs text-[#5d4d40]/80 leading-tight cursor-pointer"
            >
              I agree to the <a
                href="/privacy-policy/"
                class="text-[#4b7992] font-bold underline">Privacy Policy</a
              >
            </label>
          </div>

          <button
            type="submit"
            id="submit-btn"
            disabled
            class="group/btn relative w-full overflow-hidden bg-[#423731] text-white font-bold py-5 rounded-xl uppercase tracking-[0.2em] transition-all hover:bg-[#4b7992] disabled:opacity-50"
          >
            <span id="buttonText" class="relative z-10">Request Flight</span>
            <div
              class="absolute bottom-0 left-0 h-1 bg-[#dcc1a6] w-0 transition-all duration-500 group-hover/btn:w-full"
            >
            </div>
          </button>
        </form>
      </div>

      <div class="lg:col-span-5 lg:pl-8 py-4">
        <div class="space-y-10">
          <div>
            <h3
              class="text-[#4b7992] text-xs font-bold uppercase tracking-[0.3em] mb-4"
            >
              The Experience
            </h3>
            <p class="text-2xl font-bold text-[#423731] leading-tight">
              60 Minutes that will change your perspective.
            </p>
          </div>

          <div class="space-y-8">
            {
              [
                {
                  t: "Ground Briefing",
                  d: "Meet your instructor and perform a thorough pre-flight inspection of the aircraft.",
                },
                {
                  t: "Takeoff & Flight",
                  d: "Once airborne, your instructor will hand over the controls for basic maneuvers.",
                },
                {
                  t: "Post-Flight Debrief",
                  d: "Log your first flight hour and discuss your personalized training plan.",
                },
              ].map((item, i) => (
                <div class="flex gap-6 group">
                  <div class="flex-none w-10 h-10 rounded-full bg-[#dcc1a6]/30 flex items-center justify-center text-[#423731] font-bold group-hover:bg-[#4b7992] group-hover:text-white transition-colors">
                    {i + 1}
                  </div>
                  <div>
                    <h4 class="font-bold text-[#423731] uppercase text-sm tracking-widest">
                      {item.t}
                    </h4>
                    <p class="text-[#5d4d40]/70 text-sm mt-1">{item.d}</p>
                  </div>
                </div>
              ))
            }
          </div>

          <div
            class="p-8 rounded-3xl bg-[#4b7992] text-white shadow-xl relative overflow-hidden group"
          >
            <div class="relative z-10">
              <p
                class="text-[10px] font-bold uppercase tracking-[0.2em] mb-2 opacity-80"
              >
                Direct Admissions
              </p>
              <a
                href={`tel:${PHONE_NUMBER}`}
                class="text-2xl font-bold hover:text-[#dcc1a6] transition-colors"
                >{PHONE_NUMBER}</a
              >
            </div>
            <svg
              class="absolute right-[-10%] bottom-[-20%] w-40 h-40 text-white/10 -rotate-12 transition-transform group-hover:scale-110"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
              ></path></svg
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .group:hover rect {
    animation: drawBorder 1.2s ease-in-out forwards;
  }

  @keyframes drawBorder {
    from {
      stroke-dashoffset: 3000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Date/Input overrides to keep theme clean */
  input[type="date"]::-webkit-calendar-picker-indicator {
    filter: sepia(100%) saturate(200%) transition-all;
    cursor: pointer;
  }
</style>

<script define:vars={{ FORM_WEBHOOK_URL, PORTAL_API_KEY }}>
  // Phone Mask
  const phoneInput = document.getElementById("df-phone");
  phoneInput?.addEventListener("input", (e) => {
    let x = e.target.value
      .replace(/\D/g, "")
      .match(/(\d{0,3})(\d{0,3})(\d{0,4})/);
    e.target.value = !x[2]
      ? x[1]
      : "(" + x[1] + ") " + x[2] + (x[3] ? "-" + x[3] : "");
  });

  // Toggle Logic
  const toggle = document.getElementById("terms-toggle");
  const thumb = document.getElementById("terms-thumb");
  const hiddenInput = document.getElementById("agree-terms");
  const submitBtn = document.getElementById("submit-btn");

  toggle?.addEventListener("click", () => {
    const isChecked = hiddenInput.value === "no";
    hiddenInput.value = isChecked ? "yes" : "no";
    toggle.classList.toggle("bg-[#4b7992]", isChecked);
    toggle.classList.toggle("bg-gray-200", !isChecked);
    thumb.classList.toggle("translate-x-6", isChecked);
    thumb.classList.toggle("translate-x-1", !isChecked);
    submitBtn.disabled = !isChecked;
  });

  // Form Submission (Dual-stack)
  const form = document.getElementById("discovery-flight-form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    if (formData.get("confirm-email")) return;

    submitBtn.disabled = true;
    const btnText = document.getElementById("buttonText");
    btnText.textContent = "SENDING...";

    try {
      await Promise.all([
        fetch(FORM_WEBHOOK_URL, {
          method: "POST",
          body: new URLSearchParams(formData),
        }),
        fetch("https://portal.rightruddermarketing.com/api/leads", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "x-api-key": PORTAL_API_KEY,
          },
          body: JSON.stringify({
            first_name: formData.get("first-name"),
            last_name: formData.get("last-name"),
            email: formData.get("email"),
            phone: formData.get("phone"),
            campaign: "discovery_flight",
            metadata: { date: formData.get("preferred-date") },
          }),
        }),
      ]);
      window.location.href = "/discovery-flight-confirmation";
    } catch (err) {
      btnText.textContent = "ERROR - RETRY";
      submitBtn.disabled = false;
    }
  });
</script>
