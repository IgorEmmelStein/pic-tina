---
import { website_links } from "../../data/consts";

interface StripOffer {
  tag: string;
  name: string;
  detail: string;
  ctaLabel?: string;
  ctaHref?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  titleEm?: string;
  offers?: StripOffer[];
  contactForm?: boolean;
}

