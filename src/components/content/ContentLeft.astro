---
import ImageComp from "../utils/ImageComp.astro";
const example = {
  image: {
    src: "/src/assets/aircrew-member-using-control-panel-command-dashboard-navigation-fly-ariplane-cockpit-female-airliner-flying-plane-cabin-with-power-engine-switch-lever-close-up.jpg",
    alt: "Aircrew member using control panel in airplane cockpit",
  },
  upperHeader: "EXAMPLE UPPER HEADER",
  title: "Example Title for Content Right Component",
  description:
    "This is an example description for the Content Right component. It provides information about the content displayed on the right side of the layout.",
  descriptions: [
    "First example description point.",
    "Second example description point.",
    "Third example description point.",
  ],
  bullets: [
    {
      icon: "M3 18h18v2H3zm18.509-9.473a1.61 1.61 0 0 0-2.036-1.019L15 9L7 6L5 7l6 4l-4 2l-4-2l-1 1l4 4l14.547-5.455a1.61 1.61 0 0 0 .962-2.018",
      title: "Career Growth & Opportunity",
      description:
        "Commercial aviation, charter operations, and corporate flying all need skilled pilots. Training now positions you for a career that’s in high demand and globally respected.",
    },
    {
      icon: "M12 2a1 1 0 0 1 .932.638l7 18a1 1 0 0 1-1.326 1.281L13 19.517V13a1 1 0 1 0-2 0v6.517l-5.606 2.402a1 1 0 0 1-1.326-1.281l7-18A1 1 0 0 1 12 2",
      title: "Freedom & Adventure",
      description:
        "Enjoy the unmatched perspective of seeing the world from above. Flying offers a lifestyle of independence, excitement, and exploration few other careers can match.",
    },
    {
      icon: "",
      title: "Challenge & Achievement",
      description:
        "Learning to fly is one of life’s most rewarding accomplishments, an achievement that builds confidence, discipline, and problem-solving skills that last a lifetime.",
    },
  ],
  button: {
    text: "Learn More",
    href: "/flight-training/",
  },
};

const { content = example } = Astro.props;
---

<section
  class="relative py-20 overflow-hidden bg-linear-to-b from-primary-800 via-primary-600/90 to-primary-800"
>
  <div class="mx-auto flex max-w-7xl flex-col-reverse lg:flex-row relative">
    <!-- Text -->
    <div class="text-white lg:w-3/4 z-20">
      <div class="flex flex-col px-8 py-16 sm:px-16 lg:w-11/12">
        <p
          class="inline-flex items-center px-4 py-1 rounded-full bg-primary-600 border border-primary-500 text-white text-sm font-bold tracking-[0.25em] uppercase mb-8 self-start"
          data-aos="fade-right"
        >
          {content.upperHeader}
        </p>

        <h2
          class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight"
          data-aos="fade-right"
          data-aos-delay="100"
          set:html={content.title}
        />

        <p
          class="text-lg md:text-xl text-white py-10 mt-6 border-y border-primary-400/60 font-light leading-relaxed"
          data-aos="fade-right"
          data-aos-delay="200"
        >
          {content.description}
        </p>

        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6 py-12">
          {
            content.bullets.map((bullet) => (
              <li class="group flex flex-col items-center text-center p-8 rounded-[2rem] bg-primary-600/90 border border-white/[0.05] hover:bg-white hover:text-primary-600 transition-all duration-500 shadow-xl">
                <div class="relative mb-8">
                  <div class="absolute inset-0 rounded-full border border-primary-500/30 scale-[1.4] opacity-0 group-hover:opacity-100 group-hover:bg-primary-300/30 group-hover:rotate-180 transition-all duration-1000" />

                  <div class="relative flex h-20 w-20 items-center justify-center rounded-full bg-white/[0.05] text-white group-hover:bg-primary-500 group-hover:text-primary-800 shadow-inner transition-all duration-500">
                    <svg
                      class="w-9 h-9"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d={bullet.icon || "M5 13l4 4L19 7"}
                      />
                    </svg>
                  </div>
                </div>
                <h3 class="font-bold text-white group-hover:text-primary-800  uppercase text-[11px] tracking-[0.2em] opacity-80 group-hover:opacity-100">
                  {bullet.title}
                </h3>
              </li>
            ))
          }
        </ul>

        <div class="mt-4" data-aos="fade-up" data-aos-delay="300">
          <a href={content.button.href} class="btn-accent btn-middle">
            {content.button.text}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Image -->
  <div
    class="lg:absolute lg:top-0 lg:right-0 lg:bottom-0 lg:w-[35%] w-full h-[400px] lg:h-auto z-10 py-12"
    data-aos="fade-left"
  >
    <div class="relative w-full h-full overflow-hidden">
      <ImageComp
        src={content.image.src}
        alt={content.image.alt}
        classes="object-cover w-full h-full rounded-l-full"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-primary-900 to-transparent"
      >
      </div>
    </div>
  </div>
</section>
