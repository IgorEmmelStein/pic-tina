---
// src/components/simulators/SimulatorOfferCTA.astro
import ImageComp from "../../components/utils/ImageComp.astro";

interface Stat {
  value: string;
  unit: string;
  label: string;
}

interface ImageItem {
  src: string;
  alt: string;
}

interface Bullet {
  title: string;
  description: string;
}

interface Props {
  content?: {
    id?: string;
    upperHeader?: string;
    title?: string;
    description?: string;
    descriptions?: string[];
    stats?: Stat[];
    images?: ImageItem[];
    faaCredit?: string[];
    configurations?: string[];
    bullets?: Bullet[];
  };
  simulator?: any;
}

const { content, simulator: simulatorProp } = Astro.props;

const simulator = content || simulatorProp || {
  id: "redbird-fmx",
  upperHeader: "Operational",
  title: "Full Motion Simulator",
  description: "",
  descriptions: [],
  stats: [],
  images: [],
  faaCredit: [],
  configurations: [],
  bullets: [],
};

const simId = simulator.id || "redbird-fmx";
const sliderId = `slider-${simId}`;
const images = simulator.images || [];
---