---
import ImageComp from "../../components/utils/ImageComp.astro";
const example = {
  id: "redbird-fmx",
  upperHeader: "Operational",
  title: "Full Motion Simulator",
  description:
    "Next-generation training engineered for precision, realism, and confidence in the cockpit.",
  descriptions: [
    "Every session builds the instrument instincts and procedural fluency that matter when conditions deteriorate.",
    "From routine IFR to high-workload emergencies, the platform adapts to where you are and where you need to be.",
  ],
  stats: [
    { value: "6", unit: "-axis", label: "Motion platform" },
    { value: "$60", unit: "/hr", label: "Block rate, 10+ hrs" },
    { value: "FAA", unit: " cert.", label: "Loggable credit" },
  ],
  images: [
    {
      src: "/src/assets/drive/student-simulator-Flight-Pilot-instructional-center_flight-school_PIC-Kansas-city-Missouri.jpeg",
      alt: "Cockpit view",
    },
    {
      src: "/src/assets/fleet/red-bird-fmx_pilot-instructional-center.webp",
      alt: "Instrument panel",
    },
    {
      src: "/src/assets/fleet/red-bird-fx-simulator_motion-movement_pilot-instructional-center-1.png",
      alt: "Motion platform",
    },
    {
      src: "/src/assets/fleet/red-bird-fx-simulator_motion-movement_pilot-instructional-center-2.png",
      alt: "Motion platform",
    },
    {
      src: "/src/assets/fleet/red-bird-fx-simulator_motion-movement_pilot-instructional-center-3.png",
      alt: "Motion platform",
    },
  ],
  faaCredit: [
    "IFR instrument hours",
    "Approach procedures",
    "Emergency maneuvers",
  ],
  configurations: ["Single engine", "Multi-engine", "Jet transition"],
  bullets: [
    {
      title: "FAA certified",
      description:
        "Every hour logged counts toward your ratings and recency requirements.",
    },
    {
      title: "Adaptive scenarios",
      description:
        "Training scales from routine IFR to high-workload emergencies.",
    },
    {
      title: "Full motion fidelity",
      description:
        "Six-axis motion delivers vestibular cues that transfer to the cockpit.",
    },
  ],
};
const { simulator = example } = Astro.props;
const sliderId = `slider-${simulator.id}`;
---

<section
  id={simulator.id}
  class="relative py-16 lg:py-24 font-sans overflow-hidden bg-white border-t border-accent-500 border-2"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Top label -->
    <div class="flex items-center gap-3 mb-10">
      <span
        class="text-[10px] tracking-[0.3em] uppercase text-[#4b7992] font-medium"
      >
        System status: {simulator.upperHeader}
      </span>
      <div class="flex-1 h-px bg-[#c2d5df]"></div>
    </div>

    <!-- Hero title -->
    <h2
      class="font-serif text-[clamp(2.8rem,8vw,5.2rem)] font-normal leading-none tracking-tight text-[#423731] mb-8"
    >
      {simulator.title}
    </h2>

    <!-- Stats row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-8">
      {
        simulator.stats?.map(
          (stat: { value: string; unit: string; label: string }) => (
            <div class="bg-white border border-[#c2d5df] rounded-[22px] p-5">
              <div class="font-serif text-[2.6rem] font-normal text-[#423731] leading-none mb-1">
                {stat.value}
                <span class="text-[1.3rem] text-[#4b7992]">{stat.unit}</span>
              </div>
              <div class="text-xs tracking-[0.15em] uppercase text-[#745e4d] text-right ">
                {stat.label}
              </div>
            </div>
          ),
        )
      }
    </div>

    <!-- Main content grid -->
    <div
      class="grid grid-cols-1 lg:grid-cols-[1fr_1.6fr] gap-6 items-start mb-6"
    >
      <!-- Image Slider -->
      <div
        id={sliderId}
        class="relative rounded-[28px] overflow-hidden border border-[#c2d5df] bg-[#e0eaef]"
        style="aspect-ratio: 3/4;"
      >
        <!-- Slides track -->
        <div
          class="slider-track flex h-full transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]"
          style={`width: ${simulator.images.length * 100}%`}
        >
          {
            simulator.images.map((img: { src: string; alt: string }) => (
              <div
                class="relative h-full"
                style={`min-width: ${100 / simulator.images.length}%; width: ${100 / simulator.images.length}%`}
              >
                <ImageComp
                  src={img.src}
                  alt={img.alt}
                  classes="w-full h-full object-cover"
                />
              </div>
            ))
          }
        </div>

        <!-- Prev button -->
        <button
          class="slider-prev absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white border border-[#c2d5df] flex items-center justify-center text-[#423731] hover:bg-[#423731] hover:text-[#e0eaef] transition-colors z-10"
          aria-label="Previous image"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
          >
        </button>

        <!-- Next button -->
        <button
          class="slider-next absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white border border-[#c2d5df] flex items-center justify-center text-[#423731] hover:bg-[#423731] hover:text-[#e0eaef] transition-colors z-10"
          aria-label="Next image"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
          >
        </button>

        <!-- Dots -->
        <div
          class="slider-dots absolute bottom-12 left-0 right-0 flex justify-center gap-1.5 z-10"
        >
          {
            simulator.images.map((_: unknown, i: number) => (
              <button
                class="dot w-1.5 h-1.5 rounded-full bg-white/45 transition-all duration-200 border-0 p-0 cursor-pointer"
                data-index={i}
                aria-label={`Go to image ${i + 1}`}
              />
            ))
          }
        </div>

        <!-- Caption -->
        <div
          class="absolute bottom-0 left-0 right-0 bg-[#423731] text-[#e0eaef] text-[10px] tracking-[0.2em] uppercase px-4 py-2.5 rounded-b-[28px]"
        >
          <span class="slider-caption">{simulator.images[0]?.alt}</span>
        </div>
      </div>

      <!-- Right text panel -->
      <div class="flex flex-col gap-6">
        <!-- Pull quote -->
        <blockquote
          class="font-serif text-xl italic text-[#5d4d40] leading-relaxed bg-white border border-[#c2d5df] border-l-[3px] border-l-[#dcc1a6] rounded-[22px] px-6 py-5"
        >
          {simulator.description}
        </blockquote>

        <!-- Body paragraphs -->
        <div class="flex flex-col gap-3">
          {
            simulator.descriptions.map((desc: string) => (
              <p class="text-sm text-[#5d4d40] leading-relaxed">{desc}</p>
            ))
          }
        </div>

        <!-- FAA credit -->
        <div class="bg-white border border-[#c2d5df] rounded-[22px] p-5">
          <h4
            class="text-[10px] tracking-[0.25em] uppercase text-[#4b7992] mb-3"
          >
            FAA loggable credit
          </h4>
          {
            simulator.faaCredit.map((credit: string) => (
              <div class="flex justify-between items-center py-2 border-b border-[#f1f5f8] last:border-b-0 text-[12.5px] text-[#423731]">
                <span>{credit}</span>
                <span class="font-serif text-[13px] text-[#4b7992]">
                  Loggable
                </span>
              </div>
            ))
          }
        </div>

        <!-- Configurations -->
        <div class="bg-white border border-[#c2d5df] rounded-[22px] p-5">
          <h4
            class="text-[10px] tracking-[0.25em] uppercase text-[#4b7992] mb-3"
          >
            Configurations
          </h4>
          {
            simulator.configurations.map((config: string) => (
              <div class="flex justify-between items-center py-2 border-b border-[#f1f5f8] last:border-b-0 text-[12.5px] text-[#423731]">
                <span>{config}</span>
                <span class="font-serif text-[13px] text-[#4b7992]">
                  Available
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Offer strip -->
    <div
      class="bg-[#423731] rounded-[28px] px-8 py-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6"
    >
      <div>
        <p class="text-[10px] tracking-[0.25em] uppercase text-[#4b7992] mb-1">
          Limited offer
        </p>
        <p class="font-serif text-xl text-[#f1f5f8] italic">
          Purchase 10+ hours &mdash; lock in&nbsp;
          <strong class="not-italic font-normal text-[#dcc1a6]"
            >$60 / hour</strong
          >
          &nbsp;with a free checkout included.
        </p>
      </div>
      <a
        href="#contact"
        class="shrink-0 border bg-accent-500 border-[#dcc1a6] px-7 py-3 text-xs tracking-[0.2em] uppercase rounded-[10px] hover:bg-white text-white hover:text-accent-600 transition-all hover:-translate-y-1.5"
      >
        Authorize rate
      </a>
    </div>

    <!-- Bullet cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {
        simulator.bullets.map(
          (bullet: { title: string; description: string }, i: number) => (
            <div class="bg-white border border-[#c2d5df] rounded-[22px] p-5">
              <div class="font-serif text-[2rem] text-[#c2d5df] leading-none mb-3">
                {String(i + 1).padStart(2, "0")}
              </div>
              <h3 class="text-[12px] font-medium uppercase tracking-[0.08em] text-[#423731] mb-2">
                {bullet.title}
              </h3>
              <p class="text-[12px] text-[#745e4d] leading-relaxed">
                {bullet.description}
              </p>
            </div>
          ),
        )
      }
    </div>
  </div>
</section>

<script define:vars={{ sliderId, images: simulator.images }}>
  const root = document.getElementById(sliderId);
  if (root) {
    const track = root.querySelector(".slider-track");
    const dots = root.querySelectorAll(".dot");
    const caption = root.querySelector(".slider-caption");
    const total = images.length;
    let current = 0;
    let timer;

    function go(n) {
      current = ((n % total) + total) % total;
      track.style.transform = `translateX(-${current * (100 / total)}%)`;
      dots.forEach((d, i) => {
        d.style.background = i === current ? "white" : "rgba(255,255,255,0.45)";
        d.style.transform = i === current ? "scale(1.3)" : "scale(1)";
      });
      if (caption) caption.textContent = images[current]?.alt ?? "";
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => go(current + 1), 4000);
    }

    root.querySelector(".slider-prev")?.addEventListener("click", () => {
      go(current - 1);
      resetTimer();
    });
    root.querySelector(".slider-next")?.addEventListener("click", () => {
      go(current + 1);
      resetTimer();
    });
    dots.forEach((d) => {
      d.addEventListener("click", () => {
        go(Number(d.dataset.index));
        resetTimer();
      });
    });

    go(0);
    resetTimer();
  }
</script>
