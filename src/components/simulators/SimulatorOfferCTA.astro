---
import ImageComp from "../../components/utils/ImageComp.astro";

const example = {
  id: "simulator-redbird-fmx-full-motion-aatd",
  upperHeader: "Operational",
  title: "Full Motion Simulator",
  description:
    "Next-generation training engineered for precision, realism, and confidence in the cockpit.",
  descriptions: [
    "Every session builds the instrument instincts and procedural fluency that matter when conditions deteriorate.",
    "From routine IFR to high-workload emergencies, the platform adapts to where you are and where you need to be.",
  ],
  stats: [
    { value: "6", unit: "-axis", label: "Motion platform" },
    { value: "$60", unit: "/hr", label: "Block rate, 10+ hrs" },
    { value: "FAA", unit: " cert.", label: "Loggable credit" },
  ],
  images: [
    {
      src: "/src/assets/drive/student-simulator-Flight-Pilot-instructional-center_flight-school_PIC-Kansas-city-Missouri.jpeg",
      alt: "Cockpit view",
    },
    {
      src: "/src/assets/fleet/red-bird-fmx_pilot-instructional-center.webp",
      alt: "Instrument panel",
    },
  ],
  faaCredit: [
    "IFR instrument hours",
    "Approach procedures",
    "Emergency maneuvers",
  ],
  configurations: ["Single engine", "Multi-engine", "Jet transition"],
  bullets: [
    {
      title: "FAA certified",
      description:
        "Every hour logged counts toward your ratings and recency requirements.",
    },
    {
      title: "Adaptive scenarios",
      description:
        "Training scales from routine IFR to high-workload emergencies.",
    },
    {
      title: "Full motion fidelity",
      description:
        "Six-axis motion delivers vestibular cues that transfer to the cockpit.",
    },
  ],
};

const rawProps = Astro.props;

// 1. Safely resolve data whether passed as an Astro entry, data object, or spread props
const simulator =
  rawProps.simulator?.data ||
  rawProps.content?.data ||
  rawProps.simulator ||
  rawProps.content ||
  (rawProps.title ? rawProps : null) ||
  example;

const simId =
  simulator.id ||
  rawProps.simulator?.id ||
  rawProps.content?.id ||
  "simulator-redbird-fmx-full-motion-aatd";

const sliderId = `slider-${simId.replace(/[^a-zA-Z0-9_-]/g, "")}`;
const images = simulator.images || [];
---

<section
  id={simId}
  class="relative py-16 lg:py-24 font-sans overflow-hidden bg-white border-t border-accent-500 border-2"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-10">
      <span
        class="text-[10px] tracking-[0.3em] uppercase text-[#4b7992] font-medium"
      >
        System status: {simulator.upperHeader}
      </span>
      <div class="flex-1 h-px bg-[#c2d5df]"></div>
    </div>

    <h2
      class="font-serif text-[clamp(2.8rem,8vw,5.2rem)] font-normal leading-none tracking-tight text-[#423731] mb-8"
      set:html={simulator.title}
    />

    {simulator.stats && simulator.stats.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-8">
        {simulator.stats.map(
          (stat: { value: string; unit: string; label: string }) => (
            <div class="bg-white border border-[#c2d5df] rounded-[22px] p-5">
              <div class="font-serif text-[2.6rem] font-normal text-[#423731] leading-none mb-1">
                {stat.value}
                <span class="text-[1.3rem] text-[#4b7992]">{stat.unit}</span>
              </div>
              <div class="text-xs tracking-[0.15em] uppercase text-[#745e4d] text-right">
                {stat.label}
              </div>
            </div>
          )
        )}
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.6fr] gap-6 items-start mb-6">
      {images.length > 0 && (
        <div
          id={sliderId}
          class="relative rounded-[28px] overflow-hidden border border-[#c2d5df] bg-[#e0eaef]"
          style="aspect-ratio: 3/4;"
        >
          <div
            class="slider-track flex h-full transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]"
            style={`width: ${images.length * 100}%`}
          >
            {images.map((img: any) => {
              const imgSrc = img.src || img.imageSrc;
              const imgAlt = img.alt || img.imageAlt || simulator.title;
              const isSrcAsset = typeof imgSrc === "string" && imgSrc.startsWith("/src/assets/");

              return (
                <div
                  class="relative h-full"
                  style={`min-width: ${100 / images.length}%; width: ${100 / images.length}%`}
                >
                  {isSrcAsset ? (
                    <ImageComp
                      src={imgSrc}
                      alt={imgAlt}
                      classes="w-full h-full object-cover"
                    />
                  ) : (
                    <img
                      src={imgSrc}
                      alt={imgAlt}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  )}
                </div>
              );
            })}
          </div>

          {images.length > 1 && (
            <>
              <button
                class="slider-prev absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white border border-[#c2d5df] flex items-center justify-center text-[#423731] hover:bg-[#423731] hover:text-[#e0eaef] transition-colors z-10 cursor-pointer"
                aria-label="Previous image"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
              </button>

              <button
                class="slider-next absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white border border-[#c2d5df] flex items-center justify-center text-[#423731] hover:bg-[#423731] hover:text-[#e0eaef] transition-colors z-10 cursor-pointer"
                aria-label="Next image"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
              </button>

              <div class="slider-dots absolute bottom-12 left-0 right-0 flex justify-center gap-1.5 z-10">
                {images.map((_: unknown, i: number) => (
                  <button
                    class="dot w-1.5 h-1.5 rounded-full bg-white/45 transition-all duration-200 border-0 p-0 cursor-pointer"
                    data-index={i}
                    aria-label={`Go to image ${i + 1}`}
                  />
                ))}
              </div>
            </>
          )}

          <div class="absolute bottom-0 left-0 right-0 bg-[#423731] text-[#e0eaef] text-[10px] tracking-[0.2em] uppercase px-4 py-2.5 rounded-b-[28px]">
            <span class="slider-caption">{images[0]?.alt || images[0]?.imageAlt}</span>
          </div>
        </div>
      )}

      <div class="flex flex-col gap-6">
        {simulator.description && (
          <blockquote
            class="font-serif text-xl italic text-[#5d4d40] leading-relaxed bg-white border border-[#c2d5df] border-l-[3px] border-l-[#dcc1a6] rounded-[22px] px-6 py-5"
            set:html={simulator.description}
          />
        )}

        {simulator.descriptions && simulator.descriptions.length > 0 && (
          <div class="flex flex-col gap-3">
            {simulator.descriptions.map((desc: string) => (
              <p class="text-sm text-[#5d4d40] leading-relaxed" set:html={desc} />
            ))}
          </div>
        )}

        {simulator.faaCredit && simulator.faaCredit.length > 0 && (
          <div class="bg-white border border-[#c2d5df] rounded-[22px] p-5">
            <h4 class="text-[10px] tracking-[0.25em] uppercase text-[#4b7992] mb-3">
              FAA loggable credit
            </h4>
            {simulator.faaCredit.map((credit: string) => (
              <div class="flex justify-between items-center py-2 border-b border-[#f1f5f8] last:border-b-0 text-[12.5px] text-[#423731]">
                <span set:html={credit} />
                <span class="font-serif text-[13px] text-[#4b7992]">Loggable</span>
              </div>
            ))}
          </div>
        )}

        {simulator.configurations && simulator.configurations.length > 0 && (
          <div class="bg-white border border-[#c2d5df] rounded-[22px] p-5">
            <h4 class="text-[10px] tracking-[0.25em] uppercase text-[#4b7992] mb-3">
              Configurations
            </h4>
            {simulator.configurations.map((config: string) => (
              <div class="flex justify-between items-center py-2 border-b border-[#f1f5f8] last:border-b-0 text-[12.5px] text-[#423731]">
                <span set:html={config} />
                <span class="font-serif text-[13px] text-[#4b7992]">Available</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    {simulator.bullets && simulator.bullets.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {simulator.bullets.map((bullet: any, i: number) => {
          const isString = typeof bullet === "string";
          const colonIdx = isString ? bullet.indexOf(":") : -1;
          const title = isString
            ? (colonIdx !== -1 ? bullet.slice(0, colonIdx).trim() : `Feature ${i + 1}`)
            : bullet.title;
          const desc = isString
            ? (colonIdx !== -1 ? bullet.slice(colonIdx + 1).trim() : bullet)
            : bullet.description;

          return (
            <div class="bg-white border border-[#c2d5df] rounded-[22px] p-5">
              <div class="font-serif text-[2rem] text-[#c2d5df] leading-none mb-3">
                {String(i + 1).padStart(2, "0")}
              </div>
              <h3 class="text-[12px] font-medium uppercase tracking-[0.08em] text-[#423731] mb-2" set:html={title} />
              <p class="text-[12px] text-[#745e4d] leading-relaxed" set:html={desc} />
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>

<script define:vars={{ sliderId, images }}>
  const root = document.getElementById(sliderId);
  if (root && images.length > 1) {
    const track = root.querySelector(".slider-track");
    const dots = root.querySelectorAll(".dot");
    const caption = root.querySelector(".slider-caption");
    const total = images.length;
    let current = 0;
    let timer;

    function go(n) {
      if (total === 0) return;
      current = ((n % total) + total) % total;
      track.style.transform = `translateX(-${current * (100 / total)}%)`;
      dots.forEach((d, i) => {
        d.style.background = i === current ? "white" : "rgba(255,255,255,0.45)";
        d.style.transform = i === current ? "scale(1.3)" : "scale(1)";
      });
      if (caption) caption.textContent = images[current]?.alt || images[current]?.imageAlt || "";
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => go(current + 1), 4000);
    }

    root.querySelector(".slider-prev")?.addEventListener("click", () => {
      go(current - 1);
      resetTimer();
    });
    root.querySelector(".slider-next")?.addEventListener("click", () => {
      go(current + 1);
      resetTimer();
    });
    dots.forEach((d) => {
      d.addEventListener("click", () => {
        go(Number(d.dataset.index));
        resetTimer();
      });
    });

    go(0);
    resetTimer();
  }
</script>