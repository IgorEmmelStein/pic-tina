---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../../styles/global.css";
import {
  SITE_TITLE,
  KEYWORDS,
  INSTAGRAM_URL,
  PHONE_NUMBER,
  OG_IMAGE,
  FAVICON,
  LOGO,
} from "../../data/consts";

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
}

const site = Astro.site || "https://pilotinstructionalcenter.com";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = OG_IMAGE,
  keywords = KEYWORDS,
} = Astro.props;

const ogImageUrl = new URL(image, site).toString();
